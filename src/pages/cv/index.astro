---
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import { defaultRole, roles } from '../../data/roles';

const slugs = roles.map((r) => r.slug);
---

<Base title="CV" description={defaultRole.summary} bare>
  <!-- /cv/?role=<slug> serves the matching variant; the plain page is the one public CV. -->
  <script is:inline define:vars={{ slugs }}>
    const role = new URLSearchParams(location.search).get('role');
    if (role && slugs.includes(role)) location.replace(`/cv/${role}/`);
  </script>
  <main><CvDocument role={defaultRole} /></main>
</Base>
