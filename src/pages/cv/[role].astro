---
import Base from '../../layouts/Base.astro';
import CvDocument from '../../components/CvDocument.astro';
import { roles } from '../../data/roles';

export function getStaticPaths() {
  return roles.map((role) => ({ params: { role: role.slug }, props: { role } }));
}

const { role } = Astro.props;
---

<Base title={`CV, ${role.label}`} description={role.summary} bare noindex>
  <main><CvDocument role={role} /></main>
</Base>
