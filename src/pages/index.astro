---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/cv';
import { roles } from '../data/roles';
import { postHref } from '../lib/blog';
import ravenHome from '../assets/work/ravenclip-fresh.webp';
import ravenBiz from '../assets/work/ravenclip-business.webp';
import aiCart from '../assets/work/storagepal-ai-cart.png';

const work = Object.fromEntries((await getCollection('work')).map((w) => [w.id, w.data]));
const [latest] = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);

const stats = [
  { n: 14, suffix: '', label: 'years shipping production software' },
  { n: 100, suffix: '+', label: 'projects delivered, agency to enterprise' },
  { n: 6, suffix: '', label: 'countries built for, remote since 2018' },
  { n: 3, suffix: '', label: 'products in production today' },
];

const loop = [
  { verb: 'Specify', text: 'I write what must be true and what must never happen before any code exists.' },
  { verb: 'Delegate', text: 'Claude Code or Codex implements in small steps, inside project rules and hooks.' },
  { verb: 'Review', text: 'I read every diff for correctness, duplication and needless complexity.' },
  { verb: 'Verify', text: 'Tests, static analysis and agent-run browser scenarios check the real app. Then people do.' },
  { verb: 'Measure', text: 'Small releases, checked afterwards against production data.' },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="heroglow" aria-hidden="true"></div>
    <canvas id="gl" class="gl" aria-hidden="true"></canvas>
    <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-14 px-4 pt-20 pb-24 md:px-8 md:pt-28 lg:min-h-[86dvh] lg:grid-cols-[1.2fr_1fr] lg:gap-12 lg:pt-16 lg:pb-16">
      <div>
        <h1 class="display rise text-[2.6rem] leading-[1.02] font-bold md:text-6xl lg:text-[4.2rem]">
          <span class="block" data-scramble>Shipping software</span>
          <span class="block"><span data-scramble>since 2012.</span></span>
          <span class="mt-3 block text-muted">Agents type.</span>
          <span class="block text-accent">I own what ships.</span>
        </h1>
        <p class="rise mt-7 max-w-[52ch] text-lg leading-relaxed text-muted" style="--i:2">
          Lead full-stack engineer. 100+ projects through my own agency, five AI SaaS products, and three
          platforms in production today. I write the specs, direct Claude Code and Codex, and sign off on
          every line.
        </p>
        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--i:3">
          <a href="#work" class="btn btn-primary" data-magnet>See the work <Icon name="ph:arrow-down" /></a>
          <a href="/how-i-work/" class="btn btn-ghost">How I direct agents</a>
        </div>
      </div>
      <div class="rise relative pb-12 pl-10 max-lg:mx-auto max-lg:w-full max-lg:max-w-md md:pl-14" style="--i:2" data-tilt="2.5">
        <div class="float">
          <Image
            src={ravenHome}
            alt="RavenClip, my own SaaS, turning a live news story into a published vertical video"
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 520px, 92vw"
            loading="eager"
            class="w-full rounded-ui border border-line shadow-[0_30px_80px_-24px_rgb(0_0_0/0.6)]"
          />
        </div>
        <div class="float-late absolute bottom-0 left-0 w-[36%] max-w-[185px]">
          <Image
            src={aiCart}
            alt="StoragePal's AI cart builder on a phone"
            widths={[240, 480]}
            sizes="180px"
            loading="eager"
            class="w-full rounded-ui border border-line shadow-[0_26px_60px_-18px_rgb(0_0_0/0.65)]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-line bg-surface/40">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-4 py-12 md:grid-cols-4 md:px-8">
      {
        stats.map((s, i) => (
          <div class="fx" style={`--d:${i * 70}ms`}>
            <dt class="display text-4xl font-bold tabular-nums md:text-5xl">
              <span data-count={s.n} data-suffix={s.suffix}>0</span>
            </dt>
            <dd class="mt-2 max-w-[22ch] text-sm leading-snug text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Work -->
  <section id="work" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-32 md:px-8">
    <h2 class="display fx text-4xl font-bold tracking-tight md:text-5xl">Selected work</h2>
    <p class="fx mt-4 max-w-[60ch] text-lg text-muted" style="--d:80ms">
      Three products in production. One I lead with a team, one I built end to end for that team, and one that is
      mine, live with its first customers.
    </p>

    <div class="mt-14 grid gap-5 lg:grid-cols-5">
      <a href="/work/storagepal/" class="card tilt spot fx group grid overflow-hidden lg:col-span-3 md:grid-cols-[1fr_1.05fr]" data-tilt>
        <div class="flex flex-col p-7 md:p-8">
          <h3 class="display text-2xl font-semibold tracking-tight">{work.storagepal.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{work.storagepal.tagline}</p>
          <dl class="mt-auto grid grid-cols-2 gap-4 pt-8">
            {work.storagepal.metrics.slice(0, 2).map((m) => (
              <div>
                <dt class="display text-3xl font-semibold tabular-nums">{m.value}</dt>
                <dd class="mt-1 text-xs leading-snug text-muted">{m.label}</dd>
              </div>
            ))}
          </dl>
          <span class="mt-7 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
            Read the case study <Icon name="ph:arrow-right" class="transition-transform group-hover:translate-x-1" />
          </span>
        </div>
        <div class="relative hidden min-h-[380px] overflow-hidden md:block">
          {work.storagepal.shots.slice(0, 2).map((s, i) => (
            <Image
              src={s.src}
              alt={s.alt}
              widths={[240, 480]}
              sizes="230px"
              class:list={[
                'absolute w-[47%] rounded-ui border border-line shadow-xl',
                i === 0 ? 'top-8 left-5' : 'top-24 right-5',
              ]}
            />
          ))}
        </div>
      </a>

      <a href="/work/sps/" class="card tilt spot fx group flex flex-col !bg-[color-mix(in_oklch,var(--accent)_9%,var(--surface))] p-7 md:p-8 lg:col-span-2" data-tilt style="--d:90ms">
        <h3 class="display text-2xl font-semibold tracking-tight">{work.sps.title}</h3>
        <p class="mt-3 leading-relaxed text-muted">{work.sps.tagline}</p>
        <dl class="mt-8 grid grid-cols-2 gap-x-4 gap-y-6">
          {work.sps.metrics.map((m) => (
            <div>
              <dt class="display text-3xl font-semibold tabular-nums">{m.value}</dt>
              <dd class="mt-1 text-xs leading-snug text-muted">{m.label}</dd>
            </div>
          ))}
        </dl>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent">
          Read the case study <Icon name="ph:arrow-right" class="transition-transform group-hover:translate-x-1" />
        </span>
      </a>

      <a href="/work/ravenclip/" class="card tilt spot fx group grid overflow-hidden lg:col-span-5 lg:grid-cols-[1fr_1.4fr]" data-tilt="2.5">
        <div class="flex flex-col p-7 md:p-8">
          <h3 class="display text-2xl font-semibold tracking-tight">{work.ravenclip.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{work.ravenclip.tagline}</p>
          <ul class="mt-6 space-y-2 text-sm text-muted">
            {work.ravenclip.metrics.slice(1, 3).map((m) => (
              <li><span class="font-semibold text-fg tabular-nums">{m.value}</span> {m.label}</li>
            ))}
          </ul>
          <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent">
            Read the case study <Icon name="ph:arrow-right" class="transition-transform group-hover:translate-x-1" />
          </span>
        </div>
        <div class="overflow-hidden border-t border-line lg:border-t-0 lg:border-l">
          <Image
            src={ravenBiz}
            alt="RavenClip turning a live story into a branded vertical video for a business channel"
            widths={[640, 960, 1440]}
            sizes="(min-width: 1024px) 640px, 100vw"
            class="h-full w-full object-cover object-left-top"
          />
        </div>
      </a>
    </div>
  </section>

  <!-- Journey -->
  <section id="journey" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-36 md:px-8">
    <div class="max-w-[62ch]">
      <h2 class="display fx text-4xl font-bold tracking-tight md:text-5xl">Fourteen years, in order</h2>
      <p class="fx mt-4 text-lg leading-relaxed text-muted" style="--d:80ms">
        Long before AI could write code I was building frameworks, backends and products from scratch. The
        agents are the newest layer on a deep foundation. Open any era.
      </p>
    </div>
    <Timeline />
  </section>

  <!-- How I work -->
  <section class="mx-auto grid max-w-6xl gap-12 px-4 pt-36 md:px-8 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="display fx text-4xl font-bold tracking-tight md:text-5xl">How I work with AI</h2>
      <p class="fx mt-5 max-w-[46ch] text-lg leading-relaxed text-muted" style="--d:80ms">
        Typing code stopped being the bottleneck. Judgment did. My job is the system, the rules the agents
        work inside, and the review that decides what ships.
      </p>
      <a href="/how-i-work/" class="btn btn-ghost fx mt-8" style="--d:160ms">The full setup <Icon name="ph:arrow-right" /></a>
    </div>
    <ol class="divide-y divide-line border-y border-line">
      {
        loop.map((s, i) => (
          <li class="fx grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-6" style={`--d:${i * 60}ms`}>
            <span class="display text-lg font-semibold">{s.verb}</span>
            <span class="leading-relaxed text-muted">{s.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- CV + writing -->
  <section class="mx-auto grid max-w-6xl gap-5 px-4 pt-36 md:px-8 lg:grid-cols-[1.3fr_1fr]">
    <div class="card fx p-7 md:p-9">
      <h2 class="display text-3xl font-semibold tracking-tight">A CV for the role you're hiring for</h2>
      <p class="mt-3 max-w-[52ch] text-muted">Same fourteen years, ordered for what you need. Each one has a PDF.</p>
      <ul class="mt-7 grid gap-2 sm:grid-cols-2">
        {
          roles.map((r) => (
            <li>
              <a href={`/cv/${r.slug}/`} class="group flex items-center justify-between rounded-ui border border-line px-4 py-3 transition-colors hover:border-accent">
                {r.label}
                <Icon name="ph:arrow-up-right" class="text-muted transition-colors group-hover:text-accent" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {
      latest && (
        <a href={postHref(latest.id)} class="card spot fx group flex flex-col p-7 md:p-9" style="--d:100ms">
          <h2 class="display text-2xl font-semibold tracking-tight">Latest writing</h2>
          <h3 class="mt-4 text-lg leading-snug font-medium">{latest.data.title}</h3>
          <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">{latest.data.description}</p>
          <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium text-accent">
            Read it <Icon name="ph:arrow-right" class="transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      )
    }
  </section>

  <!-- Contact -->
  <section class="mx-auto max-w-6xl px-4 pt-40 pb-4 md:px-8">
    <h2 class="display fx max-w-[16ch] text-5xl leading-[1.02] font-bold text-balance md:text-7xl">
      Building something that has to work <span class="text-accent">every day?</span>
    </h2>
    <div class="fx mt-10 flex flex-wrap items-center gap-3" style="--d:120ms">
      <a href={`mailto:${profile.email}`} class="btn btn-primary" data-magnet>Email me <Icon name="ph:arrow-right" /></a>
      <button type="button" class="btn btn-ghost" data-copy={profile.email}>
        <Icon name="ph:copy" /> <span data-copy-label>{profile.email}</span>
      </button>
    </div>
  </section>
</Base>
