---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Reviews from '../components/Reviews.astro';
import Weekdays from '../components/viz/Weekdays.astro';
import HeroGates from '../components/HeroGates.astro';
import ExitDoor from '../components/pop/ExitDoor.astro';
import PixelArt from '../components/pop/PixelArt.astro';
import { profile, skills } from '../data/cv';
import { evidence, type ProjectId } from '../data/evidence';
import { defaultRole } from '../data/roles';
import { ASK_READY } from '../lib/ask';
import { postHref } from '../lib/blog';
import { POTIONS } from '../lib/potions';
import Stat from '../components/Stat.astro';
import catalogue from '../assets/work/storagepal-catalogue.png';
import checkout from '../assets/work/storagepal-checkout.png';
import transport from '../assets/work/storagepal-transport.png';
import ravenMakes from '../assets/work/ravenclip-shot-makes.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [latest] = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);

const years = new Date().getFullYear() - 2012;

const phones = [
  { src: catalogue, alt: 'StoragePal catalog categories and item selection' },
  { src: checkout, alt: 'StoragePal payment details together on one page' },
  { src: transport, alt: 'A StoragePal transport quote based on the collection details' },
];

const principles = [
  { icon: 'stairs', title: 'Choose the right first step.', text: 'Find what costs the business most. Ship that first, and leave the rest for later.', href: '/work/storagepal/#start-where-staff-were-blocked', link: 'Start with daily operations' },
  { icon: 'scales', title: 'Make the tradeoff explicit.', text: 'Pick the design that fits the real conditions. Extra complexity has to pay for itself.', href: '/work/sps/#remove-complexity-the-warehouse-does-not-need', link: 'Why I removed offline mode' },
  { icon: 'hourglass', title: 'Follow through after release.', text: 'Watch how people use the product, what breaks, and what it costs. Let that choose the next change.', href: '/work/ravenclip/#learn-from-the-people-who-pay', link: 'What paying customers taught me' },
] as const;
const stackWhere: Record<(typeof skills)[number]['id'], string> = {
  ai: 'RavenClip end to end, plus the cart assistant at StoragePal.',
  backend: 'Neos Flow at StoragePal. Laravel in SPS and RavenClip.',
  frontend: 'React and TypeScript in SPS and RavenClip. This site runs on Astro.',
  infra: 'All three projects, from Redis queues to FFmpeg video rendering.',
  practice: 'Shown decision by decision in the case studies.',
};
---

<Base>
  <section class="hero">
    <div class="shell">
      <h1 class="hero-title">
        <span class="sr-only">Khalil Hebachi, lead full-stack engineer</span>
        <span class="hero-name" aria-hidden="true"><span class="w"><span>Khalil</span></span> <span class="w"><span style="--i:1">Hebachi</span></span></span>
      </h1>
      <div class="hero-grid">
        <div>
          <p class="hero-statement rise" style="--i:2">Lead full-stack engineer. <mark>{years} years</mark> shipping web products.</p>
          <p class="hero-sub rise" style="--i:3">I build with Claude Code and review every change before it ships. Mostly Laravel, React and LLM products.</p>
          <div class="hero-actions rise" style="--i:4">
            <a href="#work" class="btn btn-primary">See selected work <Icon name="px-arrow-down" /></a>
            <a href={`mailto:${profile.email}`} class="btn btn-ghost">Email me <Icon name="px-arrow-up-right" /></a>
          </div>
          <p class="hero-meta rise" style="--i:5"><span>Remote, GMT+1</span><span>Teams in France, the UK, Denmark and Estonia</span></p>
        </div>
        <HeroGates />
      </div>
    </div>
  </section>

  <section id="work" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>Selected work</h2>
        <p class="sec-note">Three shipped projects. Each one shows what I owned and what happened after launch.</p>
      </header>

      <div class="work-list">
        {work.map(({ id, data: p }) => {
          const key = id as ProjectId;
          const fact = evidence[key];
          const metrics = key === 'sps' ? fact.metrics.slice(1) : fact.metrics;
          const layout = key === 'sps' ? 'is-wide' : key === 'ravenclip' ? 'is-flipped' : '';
          const copy = (
            <>
              <p class="work-headline">{p.headline}</p>
              <p class="work-text">{p.tagline}</p>
            </>
          );
          const proof = (
            <>
              <dl class="work-metrics">{metrics.map((m) => <div><dt><Stat value={m.value} /></dt><dd>{m.label}</dd></div>)}</dl>
              <p class="evidence-period">{fact.period}</p>
              <a class="work-decision" href={`/work/${id}/#${p.decisionAnchor}`}><span class="door-icon" aria-hidden="true"></span><span><span class="mono-label">A decision inside</span>{p.decision}</span><Icon name="px-arrow-right" /></a>
              <a class="work-cta mono-label" href={`/work/${id}/`}>Read the {p.title} case study <Icon name="px-arrow-right" /></a>
            </>
          );
          return (
            <article id={id} class={`work-item fx ${layout}`}>
              <p class="work-meta mono-label"><span>{p.category}</span><span>{p.period}</span></p>
              <h3 class="work-title"><a href={`/work/${id}/`}>{p.title}</a></h3>

              {key === 'storagepal' && (
                <>
                  <div class="work-copy">{copy}{proof}</div>
                  <figure class="work-visual frame-box">
                    <a class="frame-bar frame-link" href={p.url} rel="noopener"><span>Visit storagepal.fr</span><Icon name="px-arrow-up-right" /></a>
                    <div class="phones">
                      {phones.map((s) => <span class="niche"><span class="niche-in"><Image src={s.src} alt={s.alt} widths={[160, 240, 360, 480]} sizes="(min-width: 1024px) 120px, (min-width: 768px) 150px, 29vw" /></span></span>)}
                    </div>
                  </figure>
                </>
              )}

              {key === 'ravenclip' && (
                <>
                  <div class="work-copy">{copy}{proof}</div>
                  <figure class="work-visual frame-box browser">
                    <a class="frame-bar frame-link" href={p.url} rel="noopener"><span>Visit ravenclip.com</span><Icon name="px-arrow-up-right" /></a>
                    <Image src={ravenMakes} alt="RavenClip: review the script, narration, and visuals scene by scene" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 580px, 88vw" />
                  </figure>
                </>
              )}

              {key === 'sps' && (
                <>
                  <Weekdays class="work-visual" />
                  <div class="work-copy">{copy}</div>
                  <div class="work-side">{proof}</div>
                </>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="process" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>How I work</h2>
        <p class="sec-note">Three habits. Each one links to a real decision in a case study.</p>
        <div class="sec-links"><a href="/how-i-work/" class="text-link">My full approach <Icon name="px-arrow-right" /></a></div>
      </header>
      <ol class="method">
        {principles.map((p) => (
          <li class="method-row fx">
            <h3><span class="item-slot" aria-hidden="true"><PixelArt name={p.icon} /></span>{p.title}</h3>
            <p>{p.text}</p>
            <a class="method-link" href={p.href}>{p.link}<Icon name="px-arrow-right" /></a>
          </li>
        ))}
      </ol>
      <div class="ai-note fx"><h3>How I use AI</h3><p>I work with Claude Code, and sometimes Codex. I write the spec first. Then I review each change for correctness and simplicity, and I stay responsible for what ships.</p></div>
      {latest && (
        <a href={postHref(latest.id)} class="writing-row fx">
          <span class="writing-kind">Latest article · <time datetime={latest.data.date.toISOString()}>{latest.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time></span>
          <strong>{latest.data.title}</strong>
          <Icon name="px-arrow-right" />
        </a>
      )}
    </div>
  </section>

  <section id="stack" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>Stack</h2>
        <p class="sec-note">What I use in production, and where it runs.</p>
      </header>
      <dl class="stack-table fx">
        {skills.map((g) => (
          <div class="stack-row">
            <dt>{g.label}</dt>
            <dd class="stack-items">{g.items}</dd>
            <dd class="stack-where">{stackWhere[g.id]}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="journey" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>Experience</h2>
        <p class="sec-note">Building for clients around the world since 2012, from my own agency to lead roles and my own product.</p>
        <div class="sec-links">
          <a class="text-link" href="/cv/">Full CV <Icon name="px-arrow-right" /></a>
          <a class="text-link" href={`/cv/${defaultRole.slug}.pdf`}>Download PDF <Icon name="px-download" /></a>
        </div>
      </header>
      <Timeline />
      <Reviews />
    </div>
  </section>

  <section id="contact" class="band contact-band" data-hud="<b>Exit</b> · Contact">
    <div class="shell section-space contact-inner">
      <ExitDoor class="contact-exit" />
      <h2 class="fx">Hiring, or need something built?</h2>
      <p class="contact-description fx">Tell me about the role or the product. A few lines are enough to start.</p>
      <a class="contact-mail fx" href={`mailto:${profile.email}`}><span>{profile.email}</span><Icon name="px-arrow-up-right" /></a>
      <p class="potion-reward"><PixelArt name="potion" /><span>You found all {POTIONS.length} potions. Mention it when you write.</span><button type="button" class="text-link" data-potion-reset>Play again</button></p>
      <div class="contact-actions fx">
        <button type="button" class="btn btn-ghost" data-copy={profile.email} aria-label="Copy email address"><Icon name="ph:copy" /><span data-copy-label>Copy email</span></button>
        {ASK_READY && <button type="button" class="btn btn-ghost" data-ask-open aria-haspopup="dialog"><Icon name="ph:chat-circle-dots" />Ask my AI assistant</button>}
        <a class="text-link" href={profile.linkedin}>LinkedIn <Icon name="px-arrow-up-right" /></a>
        <a class="text-link" href={profile.github}>GitHub <Icon name="px-arrow-up-right" /></a>
        <span class="sr-only" data-copy-status role="status"></span>
      </div>
    </div>
  </section>
</Base>
