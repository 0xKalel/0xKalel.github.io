---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Reviews from '../components/Reviews.astro';
import Weekdays from '../components/viz/Weekdays.astro';
import HeroGates from '../components/HeroGates.astro';
import HeroLayers from '../components/HeroLayers.astro';
import HeroIndex from '../components/HeroIndex.astro';
import ContactBand from '../components/ContactBand.astro';
import PixelArt from '../components/pop/PixelArt.astro';
import { evidence, type ProjectId } from '../data/evidence';
import { defaultRole } from '../data/roles';
import { postHref } from '../lib/blog';
import Stat from '../components/Stat.astro';
import catalogue from '../assets/work/storagepal-catalogue.png';
import checkout from '../assets/work/storagepal-checkout.png';
import transport from '../assets/work/storagepal-transport.png';
// Three videos RavenClip made: the generated frames cropped out of ravenclip-shot-visuals.png, so their captions stay readable.
import ravenVideos from '../assets/work/ravenclip-videos.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [latest] = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);

const years = new Date().getFullYear() - 2012;

// A booking in the order the app takes it (selection, reservation, payment), one step per phone.
const phones = [
  { src: catalogue, step: 'Choose what to store', alt: 'StoragePal catalog categories and item selection' },
  { src: transport, step: 'Pickup details set the price', alt: 'A StoragePal transport quote based on the pickup details' },
  { src: checkout, step: 'Pay on one page', alt: 'StoragePal payment details together on one page' },
];

const principles = [
  { icon: 'stairs', title: 'Find what’s getting in the way.', text: 'At StoragePal, staff needed better tools for their daily work. That’s where I started.', href: '/work/storagepal/#start-where-staff-were-blocked', link: 'Start with daily operations' },
  { icon: 'scales', title: 'Leave out what we don’t need.', text: 'Every warehouse had internet, so I removed offline mode from SPS. Less code to look after.', href: '/work/sps/#remove-complexity-the-warehouse-does-not-need', link: 'Why I removed offline mode' },
  { icon: 'hourglass', title: 'Pay attention after launch.', text: 'RavenClip’s first customers weren’t who I expected. Their needs changed what I built next.', href: '/work/ravenclip/#learn-from-the-people-who-pay', link: 'What paying customers taught me' },
] as const;
---

<Base>
  <section class="hero">
    <div class="shell">
      <h1 class="hero-title">
        <span class="sr-only">Khalil Hebachi, lead full-stack engineer</span>
        <span class="hero-name" aria-hidden="true"><span class="w"><span>Khalil</span></span> <span class="w"><span style="--i:1">Hebachi</span></span></span>
      </h1>
      <div class="hero-grid">
        <div>
          <p class="hero-statement rise" style="--i:2">A full-stack engineer<br />you can hand a project to.</p>
          <p class="hero-sub rise" style="--i:3">I’ve spent {years} years building products and working on existing systems. I get up to speed quickly, write the code, and stay involved after launch.</p>
          <div class="hero-actions rise" style="--i:4">
            <a href="#work" class="btn btn-primary">Explore my work <Icon name="px-arrow-down" aria-hidden="true" /></a>
            <a href={`/cv/${defaultRole.slug}.pdf`} class="btn btn-ghost">Download CV <Icon name="px-download" aria-hidden="true" /></a>
          </div>
          <p class="hero-meta rise" style="--i:5"><span class="hero-open">Open to senior and lead roles, plus freelance work</span><span>Remote · GMT+1 · Open to relocation</span></p>
        </div>
        {/* One per design (lib/design.ts); the others are hidden by CSS. */}
        <HeroGates />
        <HeroLayers />
        <HeroIndex />
      </div>
    </div>
  </section>

  <section id="work" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>Selected work</h2>
        <p class="sec-note">Here’s what I’ve been working on, and the decisions behind it.</p>
      </header>

      <div class="work-list">
        {work.map(({ id, data: p }) => {
          const key = id as ProjectId;
          const fact = evidence[key];
          const metrics = key === 'sps' ? fact.metrics.slice(1) : fact.metrics;
          // StoragePal and SPS lead with a full-width exhibit; RavenClip sits beside its text.
          const layout = key === 'ravenclip' ? 'is-flipped' : 'is-wide';
          const copy = (
            <>
              <p class="work-headline">{p.headline}</p>
              <p class="work-text">{p.tagline}</p>
            </>
          );
          const numbers = (
            <>
              <dl class="work-metrics">{metrics.map((m) => <div><dt><Stat value={m.value} /></dt><dd>{m.label}</dd></div>)}</dl>
              <p class="evidence-period">{fact.period}</p>
            </>
          );
          const links = (
            <>
              <a class="work-cta mono-label" href={`/work/${id}/`}><span>Explore {p.title}</span><Icon name="px-arrow-right" aria-hidden="true" /></a>
            </>
          );
          const proof = <>{numbers}{links}</>;
          return (
            <article id={id} class={`work-item fx ${layout}`}>
              <p class="work-meta mono-label"><span>{p.category}</span><span>{p.period}</span></p>
              <h3 class="work-title">{p.title}</h3>

              {key === 'storagepal' && (
                <>
                  <figure class="work-visual frame-box">
                    <a class="frame-bar frame-link" href={p.url} rel="noopener"><span>Visit storagepal.fr</span><Icon name="px-arrow-up-right" aria-hidden="true" /></a>
                    {/* Focusable because on phones the steps scroll sideways. */}
                    <ol class="phones" aria-label="A booking on StoragePal, step by step" tabindex="0">
                      {phones.map((s, i) => (
                        <li class="phone">
                          <span class="niche"><span class="niche-in"><Image src={s.src} alt={s.alt} widths={[320, 480, 660, 990]} sizes="(min-width: 1024px) 340px, (min-width: 768px) 30vw, 72vw" /></span></span>
                          <span class="phone-step"><b aria-hidden="true">{i + 1}</b>{s.step}</span>
                        </li>
                      ))}
                    </ol>
                  </figure>
                  <div class="work-copy">{copy}{links}</div>
                  <div class="work-side">{numbers}</div>
                </>
              )}

              {key === 'ravenclip' && (
                <>
                  <div class="work-copy">{copy}{proof}</div>
                  <figure class="work-visual frame-box browser">
                    <a class="frame-bar frame-link" href={p.url} rel="noopener"><span>Visit ravenclip.com</span><Icon name="px-arrow-up-right" aria-hidden="true" /></a>
                    <Image src={ravenVideos} alt="Three short videos RavenClip made from news stories, each with real photos and animated captions" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 580px, 88vw" />
                  </figure>
                </>
              )}

              {key === 'sps' && (
                <>
                  <Weekdays class="work-visual" />
                  <div class="work-copy">{copy}{links}</div>
                  <div class="work-side">{numbers}</div>
                </>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="process" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>How I work</h2>
        <p class="sec-note">A few choices that say more than a list of principles.</p>
        <div class="sec-links"><a href="/how-i-work/" class="text-link">More about how I work <Icon name="px-arrow-right" aria-hidden="true" /></a></div>
      </header>
      <ol class="method">
        {principles.map((p) => (
          <li class="method-row fx">
            <h3><span class="item-slot" aria-hidden="true"><PixelArt name={p.icon} /></span>{p.title}</h3>
            <p>{p.text}</p>
            <a class="method-link" href={p.href}>{p.link}<Icon name="px-arrow-right" aria-hidden="true" /></a>
          </li>
        ))}
      </ol>
      {latest && (
        <a href={postHref(latest.id)} class="writing-row fx">
          <span class="writing-kind">Latest article · <time datetime={latest.data.date.toISOString()}>{latest.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time></span>
          <strong>{latest.data.title}</strong>
          <Icon name="px-arrow-right" aria-hidden="true" />
        </a>
      )}
    </div>
  </section>


  <section id="journey" class="band">
    <div class="shell section-space">
      <header class="sec-head fx">
        <h2><span class="sec-num" aria-hidden="true"></span>Experience</h2>
        <p class="sec-note">I co-founded a development agency in 2012. These days, I look after StoragePal and build RavenClip.</p>
        <div class="sec-links">
          <a class="text-link" href="/cv/">Full CV <Icon name="px-arrow-right" aria-hidden="true" /></a>
          <a class="text-link" href={`/cv/${defaultRole.slug}.pdf`}>Download PDF <Icon name="px-download" aria-hidden="true" /></a>
        </div>
      </header>
      <Timeline />
      <Reviews />
    </div>
  </section>

  <ContactBand full heading="What are you working on?" description="Tell me about the product, the role, or the problem you need help with." />
</Base>
