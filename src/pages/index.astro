---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { profile } from '../data/cv';
import { defaultRole } from '../data/roles';
import { postHref } from '../lib/blog';
import raven from '../assets/work/ravenclip-business.webp';
import catalogue from '../assets/work/storagepal-catalogue-grid.png';
import cart from '../assets/work/storagepal-ai-cart.png';
import scan from '../assets/work/sps-01-movein-scan.png';
import bay from '../assets/work/sps-03-bay-move.png';

const work = Object.fromEntries((await getCollection('work')).map((w) => [w.id, w.data]));
const [latest] = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const projects = [
  { id: 'storagepal', role: 'Technical leadership', images: [catalogue, cart], alts: ['StoragePal catalogue', 'StoragePal AI cart'], metrics: [work.storagepal.metrics[3], work.storagepal.metrics[2]], stack: 'PHP · JavaScript · Stripe' },
  { id: 'sps', role: 'Full-stack development', images: [scan, bay], alts: ['SPS scanning interface', 'SPS inventory interface'], metrics: [work.sps.metrics[1], work.sps.metrics[3]], stack: 'Laravel · React · Redis' },
  { id: 'ravenclip', role: 'Founder & AI engineering', images: [raven], alts: ['RavenClip video creation interface'], metrics: [work.ravenclip.metrics[0], work.ravenclip.metrics[1]], stack: 'Laravel · React · AI pipelines' },
];
const loop = [
  { verb: 'Plan', text: 'Define the problem and agree on the result.' },
  { verb: 'Build', text: 'Make small changes. Review and test each one.' },
  { verb: 'Improve', text: 'Release, check the results and fix what needs work.' },
];
---

<Base>
  <section class="hero-section">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <p class="rise text-sm text-muted">Lead full-stack engineer</p>
        <h1 class="hero-title rise" style="--i:1">I build software<br /><span>people rely on.</span></h1>
        <p class="hero-description rise" style="--i:2">Web apps. AI products. Technical leadership.<br />Building worldwide since 2012.</p>
        <div class="hero-actions rise" style="--i:3">
          <a href="#work" class="btn btn-primary">Explore my work <Icon name="ph:arrow-down" /></a>
          <a href="/cv/" class="btn btn-ghost">View CV <Icon name="ph:arrow-up-right" /></a>
        </div>
        <div class="hero-meta rise" style="--i:4">
          <span><Icon name="ph:map-pin" /> Annaba, Algeria · GMT+1</span>
          <a href={profile.github} aria-label="Khalil on GitHub"><Icon name="ph:github-logo" /></a>
          <a href={profile.linkedin} aria-label="Khalil on LinkedIn"><Icon name="ph:linkedin-logo" /></a>
        </div>
      </div>
      <ProjectPreview />
    </div>
  </section>

  <section id="work" class="shell section-space">
    <div class="section-heading fx">
      <div><h2>Built for real use.</h2></div>
    </div>
    <div class="project-grid">
      {projects.map((p, i) => (
        <a href={`/work/${p.id}/`} class={`project-card fx project-${p.id}`} style={`--d:${i * 65}ms`}>
          <div class="project-cover" data-spotlight>
                        <div class={`project-screens ${p.images.length === 1 ? 'project-screens-wide' : ''}`}>
              {p.images.map((src, n) => <Image src={src} alt={p.alts[n]} widths={p.images.length === 1 ? [640, 960] : [240, 480]} sizes={p.images.length === 1 ? '(min-width: 768px) 400px, 90vw' : '180px'} class={`project-screen screen-${n}`} />)}
            </div>
            <span class="project-arrow" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
          </div>
          <div class="project-info">
            <p class="text-sm text-muted">{p.role}</p>
            <h3>{work[p.id].title}</h3>
            <p class="project-description">{work[p.id].tagline}</p>
            <dl class="project-results">
              {p.metrics.map((m) => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}
            </dl>
            <p class="project-stack">{p.stack}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="journey" class="shell section-space experience-section">
    <div class="section-heading fx">
      <div><h2>Fourteen years.<br />Still building.</h2></div>
      <a class="text-link" href="/cv/">Full CV <Icon name="ph:arrow-up-right" /></a>
    </div>
    <Timeline />
  </section>

  <section id="process" class="shell section-space">
    <div class="process-panel">
      <div class="section-heading fx">
        <div><h2>Plan. Build. Improve.</h2></div>
        <a href="/how-i-work/" class="text-link">My process <Icon name="ph:arrow-up-right" /></a>
      </div>
      <ol class="process-grid">
        {loop.map((s, i) => (
          <li class="fx" style={`--d:${i * 70}ms`}><span class="process-number" aria-hidden="true">0{i + 1}</span><h3>{s.verb}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shell section-space resources-grid">
    <div class="resource-panel fx">
      <h2>My CV</h2>
      <ul class="role-links">
        <li><a href="/cv/">View online<Icon name="ph:arrow-up-right" /></a></li>
        <li><a href={`/cv/${defaultRole.slug}.pdf`}>Download PDF<Icon name="ph:download-simple" /></a></li>
      </ul>
    </div>
    {latest && (
      <a href={postHref(latest.id)} class="resource-panel writing-panel fx" style="--d:80ms">
        <p class="text-sm text-muted">Latest writing</p>
        <span class="writing-symbol" aria-hidden="true"><Icon name="ph:code" /></span>
        <h2>{latest.data.title}</h2>
        <span class="text-link">Read the article <Icon name="ph:arrow-up-right" /></span>
      </a>
    )}
  </section>

  <section id="contact" class="shell section-space contact-section">
        <h2 class="fx">Let’s build<br /><span>something useful.</span></h2>
    <div class="contact-actions fx">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">Email me <Icon name="ph:arrow-up-right" /></a>
      <button type="button" class="btn btn-ghost" data-copy={profile.email} aria-label="Copy email address"><Icon name="ph:copy" /><span data-copy-label>Copy email</span></button>
      <span class="sr-only" data-copy-status role="status"></span>
    </div>
  </section>
</Base>
