---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { evidence, type ProjectId } from '../../data/evidence';
import { profile } from '../../data/cv';
export async function getStaticPaths() {
  return (await getCollection('work')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const facts = evidence[entry.id as ProjectId];
const galleryVideos = [...(d.video ? [{ ...d.video, caption: `${d.title} product walkthrough` }] : []), ...d.videos];
const related = (await getCollection('work')).filter((w) => w.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
---
<Base title={`${d.title}: ${d.headline.replace(/\.$/, '')}`} description={d.tagline}>
  <article class="shell case-study">
    <a href="/#work" class="text-link"><Icon name="ph:arrow-left" /> Selected work</a>
    <header class="case-header">
      <p class="eyebrow rise">{d.category}</p>
      <h1 class="rise">{d.title}<span class="sr-only">: </span><span>{d.headline}</span></h1>
      <p class="case-intro rise">{d.tagline}</p>
      <dl class="case-meta"><div><dt>My role</dt><dd>{d.role}</dd></div><div><dt>Period</dt><dd>{d.period}</dd></div><div><dt>Core stack</dt><dd>{d.stack}</dd></div></dl>
    </header>
    <div class="case-evidence">
      <dl class="case-metrics">{facts.metrics.map((m) => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}</dl>
      <p class="evidence-period">{facts.period}</p>
    </div>
    <div class="case-body">
      <nav class="case-nav" aria-label="In this case study"><p class="eyebrow">In this case study</p><ul>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}<li><a href="#product-walkthrough">Product walkthrough</a></li></ul></nav>
      <div class="prose prose-case prose-headings:tracking-tight prose-a:decoration-line prose-a:underline-offset-4 prose-strong:font-semibold"><Content /></div>
    </div>
    <section id="product-walkthrough" class="case-gallery"><div class="section-heading"><div><p class="eyebrow">Inside the product</p><h2>Product walkthrough</h2></div>{d.url && <a href={d.url} class="text-link">Visit {d.title} <Icon name="ph:arrow-up-right" /></a>}</div><Gallery videos={galleryVideos} shots={d.shots} /></section>
    <section class="case-related" aria-labelledby="related-heading"><h2 id="related-heading">More work</h2><div>{related.map((w) => <a href={`/work/${w.id}/`}><span>{w.data.title}<Icon name="ph:arrow-up-right" /></span><p>{w.data.headline}</p></a>)}</div></section>
    <p class="case-contact">Working through a similar problem? <a class="link" href={`mailto:${profile.email}`}>Tell me about it.</a></p>
  </article>
</Base>
