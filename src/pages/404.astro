---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page is missing. Explore Khalil Hebachi’s work or return to the homepage." noindex>
  <section class="shell section-space">
    <p class="eyebrow">404 · Page not found</p>
    <h1 class="display mt-5 max-w-xl text-4xl leading-tight md:text-6xl">That page isn’t here.</h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">The link may be old or incomplete. You can find my latest projects, writing, and contact details on the homepage.</p>
    <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/">Back to the homepage</a><a class="btn btn-ghost" href="/#work">Selected work</a></div>
  </section>
</Base>
