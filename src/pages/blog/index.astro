---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { postHref } from '../../lib/blog';
import Potion from '../../components/pop/Potion.astro';
import PotionMark from '../../components/pop/PotionMark.astro';
import { potionsUnder } from '../../lib/potions';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Writing" description="Notes by Khalil Hebachi on building and running software: AI products, Laravel and React work, and the tools I use with Claude Code.">
  <section class="shell">
    <header class="page-head">
      <h1 class="rise">Writing</h1>
      <p class="rise" style="--i:1">Notes on building and maintaining software.</p>
    </header>
    <ul class="post-list">
      {
        posts.map((p, i) => (
          <li class="rise" style={`--i:${i + 2}`}>
            <a href={postHref(p.id)} data-potion-link={potionsUnder(postHref(p.id))}>
              <time class="mono-label text-muted" datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </time>
              <div>
                <strong><span>{p.data.title}</span><PotionMark /></strong>
                <p>{p.data.description}</p>
              </div>
              <span class="door-icon" aria-hidden="true"></span>
            </a>
          </li>
        ))
      }
    </ul>
    <Potion id="blog" />
  </section>
</Base>
