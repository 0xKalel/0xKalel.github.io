---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { postHref } from '../../lib/blog';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Writing" description="What I’ve learned from building AI products, improving performance and maintaining software in production.">
  <section class="mx-auto max-w-3xl px-4 pt-14 md:px-8 md:pt-20">
    <h1 class="rise text-4xl font-semibold tracking-[-0.035em] md:text-5xl">Writing</h1>
    <p class="rise mt-5 text-lg text-muted" style="--i:1">What I’ve learned from building AI products, improving performance and maintaining software in production.</p>
    <ul class="mt-12 divide-y divide-line border-y border-line">
      {
        posts.map((p) => (
          <li>
            <a href={postHref(p.id)} class="group grid gap-2 py-7 sm:grid-cols-[8rem_1fr] sm:gap-6">
              <time class="font-mono text-xs text-muted sm:pt-1.5" datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
              </time>
              <span>
                <span class="text-lg font-medium group-hover:text-accent">{p.data.title}</span>
                <span class="mt-2 block text-sm leading-relaxed text-muted">{p.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
