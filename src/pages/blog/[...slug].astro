---
import { getCollection, render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { postSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: postSlug(post.id) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Prose title={post.data.title} description={post.data.description} date={post.data.date} updated={post.data.updated} headings={headings}>
  <Content />
</Prose>
