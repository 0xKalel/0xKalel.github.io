---
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  updated?: Date;
  /** With two or more h2s the page gets the wide layout with a section nav. MDX pages
   *  using this as their `layout` receive headings automatically. */
  headings?: MarkdownHeading[];
  /** Set by Astro when this layout wraps a Markdown page. */
  frontmatter?: { title: string; description: string; date?: Date; updated?: Date };
}

const { title, description, date, updated } = Astro.props.frontmatter ?? Astro.props;
const sections = (Astro.props.headings ?? []).filter((h) => h.depth === 2);
const navLabel = date ? 'In this article' : 'On this page';
const long = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={title} description={description} published={date} updated={updated}>
  {
    sections.length > 1 ? (
      <article class="shell case-study post">
        {date && <a href="/blog/" class="text-link"><Icon name="ph:arrow-left" /> Writing</a>}
        <header class="case-header">
          {date && <p class="eyebrow rise"><time datetime={date.toISOString()}>{long(date)}</time>{updated && <> · Updated <time datetime={updated.toISOString()}>{long(updated)}</time></>}</p>}
          <h1 class="rise">{title}</h1>
          <p class="case-intro rise">{description}</p>
        </header>
        <div class="case-body">
          <nav class="case-nav" aria-label={navLabel}><p class="eyebrow">{navLabel}</p><ul>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
          <div class="prose prose-case prose-headings:tracking-tight prose-a:decoration-line prose-a:underline-offset-4 prose-strong:font-semibold"><slot /></div>
        </div>
      </article>
    ) : (
      <article class="mx-auto max-w-3xl px-4 pt-14 md:px-8 md:pt-20">
        {date && <p class="rise font-mono text-xs text-muted"><time datetime={date.toISOString()}>{long(date)}</time>{updated && <> · Updated <time datetime={updated.toISOString()}>{long(updated)}</time></>}</p>}
        <h1 class="rise mt-4 text-4xl leading-[1.08] font-semibold tracking-[-0.035em] text-balance md:text-5xl">{title}</h1>
        <p class="rise mt-5 text-lg leading-relaxed text-muted" style="--i:1">{description}</p>
        <div class="prose mt-12 prose-headings:tracking-tight prose-a:decoration-line prose-a:underline-offset-4 prose-strong:font-semibold prose-h2:mt-14">
          <slot />
        </div>
      </article>
    )
  }
</Base>
