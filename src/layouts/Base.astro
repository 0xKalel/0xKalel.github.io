---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/jersey-10';
// Preloaded so the pixel font is ready at first paint; its wider stand-in could otherwise push the layout.
import jerseyLatin from '@fontsource/jersey-10/files/jersey-10-latin-400-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import Ask from '../components/Ask.astro';
import Hud from '../components/Hud.astro';
import { profile } from '../data/cv';
import { POTIONS, SOUND_ON_BY_DEFAULT } from '../lib/potions';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the CV) skip the chrome, the scripts and the router. */
  bare?: boolean;
  noindex?: boolean;
  published?: Date;
  updated?: Date;
}

const {
  title,
  description = `Khalil Hebachi, lead full-stack engineer. ${new Date().getFullYear() - 2012} years shipping web products. I build with Claude Code and review every change before it ships.`,
  bare = false,
  noindex = false,
  published,
  updated,
} = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name}, lead full-stack engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-preview.png', Astro.site);
const GA_ID = 'G-SLJ8G6MSCP';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={jerseyLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="Writing by Khalil Hebachi" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Khalil Hebachi, lead full-stack engineer. Shipping web products since 2012." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Khalil Hebachi, lead full-stack engineer. Shipping web products since 2012." />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="theme-color" content="#090f1c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6efe3" media="(prefers-color-scheme: light)" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      jobTitle: 'Lead Full-Stack Engineer',
      email: `mailto:${profile.email}`,
      url: profile.site,
      sameAs: [profile.github, profile.linkedin],
      knowsLanguage: ['en', 'fr', 'ar'],
    })} />
    {published && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: published.toISOString(),
      ...(updated && { dateModified: updated.toISOString() }),
      author: { '@type': 'Person', name: profile.name, url: profile.site },
      mainEntityOfPage: canonical.href,
    })} />}
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: profile.name,
      url: profile.site,
    })} />}
    {!bare && <ClientRouter />}
    <script is:inline define:vars={{ potionIds: POTIONS, soundDefault: SOUND_ON_BY_DEFAULT }}>
      // The router copies each new page's <html> attributes over the current ones, and this
      // head script runs only once, so re-apply the saved theme, the potion game (lib/potions.ts)
      // and the js flag after every swap. Applying them here, before paint, keeps the HUD from flickering.
      (() => {
        const apply = () => {
          const html = document.documentElement;
          html.classList.add('js');
          let drunk = [];
          let exit;
          let sound;
          try {
            drunk = JSON.parse(localStorage.getItem('potions') || '[]');
            exit = localStorage.getItem('potions:exit');
            sound = localStorage.getItem('sound');
          } catch {}
          const count = Array.isArray(drunk) ? potionIds.filter((id) => drunk.includes(id)).length : 0;
          html.style.setProperty('--potions', count);
          if (count === potionIds.length) html.dataset.potions = 'full';
          if (exit === 'open') html.dataset.exit = 'open';
          if (sound ? sound === 'on' : soundDefault) html.dataset.sound = 'on';
          let t;
          try { t = localStorage.getItem('theme'); } catch {}
          if (t !== 'light' && t !== 'dark') return;
          html.dataset.theme = t;
          const color = t === 'light' ? '#f6efe3' : '#090f1c';
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.setAttribute('content', color);
            m.removeAttribute('media');
          });
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    {
      import.meta.env.PROD && !bare && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            // define:vars wraps this script in a function, so put gtag on window for the site's events.
            window.gtag = function gtag() {
              dataLayer.push(arguments);
            };
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-dvh font-sans text-fg">
    {bare ? <slot /> : (
      <>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <div class="page-frame" aria-hidden="true"></div>
        <Nav />
        <main id="main-content" tabindex="-1"><slot /></main>
        <Footer />
        <Palette />
        <Ask />
        <Hud title={title ?? profile.name} />
        <script>
          import '../scripts/site';
        </script>
      </>
    )}
  </body>
</html>
