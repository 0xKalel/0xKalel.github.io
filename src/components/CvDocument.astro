---
import { Icon } from 'astro-icon/components';
import { education, profile, type Entry } from '../data/cv';
import type { Role } from '../data/roles';
import { buildCv, trackedHref } from '../lib/cv';
import { inline } from '../lib/inline';

interface Props {
  role: Role;
}

const { role } = Astro.props;
const cv = buildCv(role);
const abs = (href: string) => new URL(trackedHref(href, role), profile.site).href;
const siteHref = abs('/');
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', href: profile.linkedin },
  { label: 'GitHub', href: profile.github },
  { label: 'Portfolio', href: siteHref },
];
const sectionTitle = { experience: 'Experience', projects: 'Independent product', skills: 'Skills', education: 'Education' };
---

<div class="toolbar mx-auto flex max-w-[210mm] flex-wrap items-center justify-between gap-4 px-4 pt-6 pb-4 text-sm print:hidden">
  <a href="/" class="inline-flex items-center gap-1.5 py-2 text-muted hover:text-fg"><Icon name="ph:arrow-left" /> Portfolio</a>
  <a href={`/cv/${role.slug}.pdf`} class="btn btn-primary h-9! px-3.5!" download>Download PDF <Icon name="ph:download-simple" /></a>
</div>

<article class="paper mx-auto mb-16 max-w-[210mm] bg-bg px-[14mm] py-[13mm] text-[10pt] leading-[1.45] text-fg shadow-[0_30px_80px_-30px_oklch(0.1_0.02_250/0.5)] print:m-0 print:max-w-none print:p-0 print:shadow-none">
  <header class="border-b border-line pb-4">
    <h1 class="text-[24pt] leading-none font-bold tracking-tight">{profile.name}</h1>
    <p class="mt-2 text-[12pt] font-semibold text-accent">{role.headline}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[9.5pt] text-muted">
      <span>{profile.location}</span>
      {contacts.map((c) => (
        <span><span aria-hidden="true">{'\u00A0·\u00A0'}</span><a href={c.href} class="underline decoration-line underline-offset-2">{c.label}</a></span>
      ))}
    </p>
  </header>

  <p class="mt-4 text-[10.5pt] leading-[1.55]">{role.summary}</p>

  <p class="mt-2 text-[9pt] text-muted">
    <span class="font-medium text-fg">See also:{'\u00A0'}</span>
    {role.links.map((l, i) => (
      <>
        {i > 0 && ', '}
        <a href={abs(l.href)} class="underline decoration-line underline-offset-2">{l.label}</a>
      </>
    ))}
  </p>

  {
    role.sections.map((section) => (
      <section class="mt-6">
        <h2 class="flex items-center gap-3 text-[9.5pt] font-semibold tracking-[0.1em] uppercase">
          <span>{sectionTitle[section]}</span>
          <span class="h-px flex-1 bg-line" aria-hidden="true" />
        </h2>

        {(section === 'experience' || section === 'projects') &&
          (section === 'experience' ? cv.experience : cv.projects).map((e: Entry) => (
            <div class="mt-3.5 break-inside-avoid-page">
              <h3 class="text-[10.5pt] leading-snug font-semibold">{e.title}</h3>
              <p class="mt-0.5 text-[9.5pt] text-muted">
                <span class="font-medium text-fg">{e.url ? <a href={e.url} class="underline decoration-line underline-offset-2">{e.org}</a> : e.org}</span>
                {' · '}{e.location}{' · '}<span class="tabular-nums">{e.period}</span>
              </p>
              {e.intro && <p class="mt-1 text-[9.5pt] text-muted">{e.intro}</p>}
              <ul class="mt-1.5 list-disc space-y-1 pl-[1.05rem] marker:text-[color-mix(in_oklch,var(--accent)_55%,var(--line))]">
                {e.bullets.map((b) => (
                  <li set:html={inline(b.text)} />
                ))}
              </ul>
              {e.stack && <p class="mt-1.5 text-[8.5pt] text-muted">{e.stack}</p>}
            </div>
          ))}

        {section === 'skills' && (
          <div class="mt-2.5 grid grid-cols-2 gap-x-7 gap-y-2 text-[9.5pt] leading-[1.5] max-sm:grid-cols-1">
            {cv.skills.map((s) => (
              <p><span class="font-semibold">{s.label}.{'\u00A0'}</span><span class="text-muted">{s.items}</span></p>
            ))}
            <p><span class="font-semibold">Languages.{'\u00A0'}</span><span class="text-muted">{profile.languages}</span></p>
          </div>
        )}

        {section === 'education' && (
          <p class="mt-3 text-[9.5pt]">
            <span class="font-medium">{education.degree}</span>, {education.school}, {education.year}.{' '}
            <span class="text-muted">{education.focus}.</span>
          </p>
        )}
      </section>
    ))
  }
</article>

<style is:global>
  /* The CV is a document: always light, whatever the site theme. */
  .paper {
    --bg: oklch(0.995 0 0);
    --fg: oklch(0.19 0.012 250);
    --muted: oklch(0.44 0.012 250);
    --line: oklch(0.86 0.006 250);
    --accent: oklch(0.47 0.12 160);
    color-scheme: light;
  }
  .paper strong {
    font-weight: 600;
  }
  @page {
    size: A4;
    margin: 13mm 14mm;
  }
  @media print {
    html,
    body {
      background: white !important;
    }
  }
</style>
