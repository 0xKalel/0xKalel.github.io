---
/** Third-party voices, rendered from src/data/reviews.ts (shared with the
 *  ask-chat knowledge document). Avatars are served locally because LinkedIn
 *  media URLs expire. The first three show; the rest open with "Show more"
 *  (all of them show without JavaScript). */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { linkedinReviews as linkedin, freelanceReviews as freelance, type AvatarKey } from '../data/reviews';
import jesse from '../assets/reviews/jesse.jpg';
import med from '../assets/reviews/med.jpg';
import fateh from '../assets/reviews/fateh.jpg';
import richard from '../assets/reviews/richard.jpg';
import zach from '../assets/reviews/zach.jpg';

const avatars: Record<AvatarKey, ImageMetadata> = { jesse, med, fateh, richard, zach };
const FEATURED = 3;
const hidden = linkedin.length + freelance.length - FEATURED;

const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<div class="reviews" data-more>
  <h3 class="reviews-title fx">Recommendations</h3>
  <div class="review-grid" id="review-list">
    {linkedin.map((r, i) => (
      <figure class="review" data-more-extra={i >= FEATURED ? true : undefined}>
        <div class="review-head">
          {r.avatar ? (
            <Image src={avatars[r.avatar]} alt="" widths={[88]} sizes="44px" class="review-avatar" />
          ) : (
            <span class="review-avatar review-monogram" aria-hidden="true">{initials(r.name)}</span>
          )}
          <div>
            <a class="review-name" href={r.href} rel="noopener">{r.name}</a>
            <p class="review-role">{r.role}</p>
          </div>
        </div>
        {r.translation ? (
          <blockquote>{r.translation}</blockquote>
        ) : (
          <blockquote lang={r.lang}>{r.quote}</blockquote>
        )}
        <figcaption>{r.tag} · LinkedIn{r.translation && ' · Translated from French'}</figcaption>
      </figure>
    ))}
    {freelance.map((r) => (
      <figure class="review" data-more-extra>
        <div class="review-head">
          <span class="review-avatar review-monogram" aria-hidden="true">{initials(r.name.replace('.', ''))}</span>
          <div>
            <p class="review-name">{r.name}</p>
            <p class="review-role">Freelance client</p>
          </div>
        </div>
        <blockquote>{r.quote}</blockquote>
        <figcaption>Client review · freelancer.com, 2012-2018</figcaption>
      </figure>
    ))}
    <p class="review-source" data-more-extra>
      The freelance reviews come from 300 projects for clients worldwide through Mawaki3’s freelancer.com
      profile (mondersky), 2012-2018.
    </p>
  </div>
  <button type="button" class="btn btn-ghost review-toggle" data-more-toggle aria-expanded="false" aria-controls="review-list">
    <span data-more-label data-open-label="Show fewer">Show {hidden} more</span>
    <Icon name="px-caret-down" aria-hidden="true" />
  </button>
</div>

<style>
  .reviews { margin-top: clamp(3.5rem, 6vw, 5.5rem); }
  .reviews-title {
    padding-bottom: 14px;
    border-bottom: var(--rule);
    font-family: var(--font-pixel);
    font-size: calc(var(--grid) * 2);
    font-weight: 400;
    line-height: calc(var(--fp) * 20);
  }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  /* Each voice is a game dialog box: a double frame and a pixel nameplate. */
  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 1.5rem 1.6rem 1.7rem;
    border: 2px solid var(--fg);
    background: var(--raised);
    box-shadow: inset 0 0 0 4px var(--raised), inset 0 0 0 6px color-mix(in oklab, var(--fg) 35%, var(--raised));
  }
  .review-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .review-avatar {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    flex: none;
    border: 2px solid var(--fg);
  }
  .review-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-pixel);
    font-size: var(--pixel-label);
    color: var(--inv-accent);
    background: var(--fg);
  }
  .review-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -10px;
    font-family: var(--font-pixel);
    font-size: var(--pixel-label);
    color: var(--fg);
  }
  a.review-name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease;
  }
  a.review-name:hover { text-decoration-color: var(--accent); }
  .review-role {
    font-size: var(--text-meta);
    color: var(--muted);
    margin-top: 0.1rem;
  }
  .review blockquote {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--fg);
  }
  .review figcaption {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-meta);
    line-height: 1.5;
    color: var(--muted);
  }
  .review-source {
    grid-column: 1 / -1;
    max-width: 68ch;
    font-size: var(--text-meta);
    color: var(--muted);
    line-height: 1.6;
  }
  .review-toggle { margin-top: 1.5rem; }
  .review-toggle svg { transition: transform 220ms var(--ease-out); }
  .review-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  @media (max-width: 767px) { .review-toggle { width: 100%; justify-content: center; } }
</style>
