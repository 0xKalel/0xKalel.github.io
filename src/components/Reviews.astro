---
/** Third-party voices, rendered from src/data/reviews.ts (shared with the
 *  ask-chat knowledge document). Avatars are served locally because LinkedIn
 *  media URLs expire. */
import { Image } from 'astro:assets';
import { linkedinReviews as linkedin, freelanceReviews as freelance, type AvatarKey } from '../data/reviews';
import jesse from '../assets/reviews/jesse.jpg';
import med from '../assets/reviews/med.jpg';
import fateh from '../assets/reviews/fateh.jpg';
import richard from '../assets/reviews/richard.jpg';
import zach from '../assets/reviews/zach.jpg';

const avatars: Record<AvatarKey, ImageMetadata> = { jesse, med, fateh, richard, zach };

const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<div class="review-strip">
  {linkedin.map((r, i) => (
    <figure class="review fx" style={`--d:${(i % 3) * 60}ms`}>
      <div class="review-head">
        {r.avatar ? (
          <Image src={avatars[r.avatar]} alt="" widths={[80]} sizes="40px" class="review-avatar" />
        ) : (
          <span class="review-avatar review-monogram" aria-hidden="true">{initials(r.name)}</span>
        )}
        <div>
          <a class="review-name" href={r.href} rel="noopener">{r.name}</a>
          <p class="review-role">{r.role}</p>
        </div>
      </div>
      <blockquote lang={r.lang}>{r.quote}</blockquote>
      <figcaption>{r.tag} · LinkedIn</figcaption>
    </figure>
  ))}
  {freelance.map((r, i) => (
    <figure class="review fx" style={`--d:${i * 60}ms`}>
      <blockquote>{r.quote}</blockquote>
      <figcaption>{r.name} · freelancer.com</figcaption>
    </figure>
  ))}
  <p class="review-source fx">
    Recommendations from LinkedIn, plus client reviews from the freelance years: 300 projects for
    clients worldwide through Mawaki3’s freelancer.com profile (mondersky), 2012-2018.
  </p>
</div>

<style>
  .review-strip {
    /* .experience-section is a two-column grid; the strip spans it. */
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }
  .review {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .review-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .review-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .review-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    background: color-mix(in oklch, var(--fg) 6%, var(--surface));
    border: 1px solid var(--line);
  }
  .review-name {
    display: inline-block;
    padding-block: 6px;
    margin-block: -6px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--fg);
  }
  .review-name:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .review-role {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }
  .review blockquote {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .review > blockquote:first-child::before {
    content: '“';
    display: block;
    font-size: 1.9rem;
    line-height: 1;
    color: color-mix(in oklch, var(--accent) 70%, var(--muted));
    margin-bottom: 0.35rem;
  }
  .review figcaption {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .review-source {
    grid-column: 1 / -1;
    max-width: 68ch;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
  }
  @media (max-width: 1023px) {
    .review-strip {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .review-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
