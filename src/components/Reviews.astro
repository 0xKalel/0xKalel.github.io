---
/** Third-party voices, rendered from src/data/reviews.ts (shared with the
 *  ask-chat knowledge document). Avatars are served locally because LinkedIn
 *  media URLs expire. */
import { Image } from 'astro:assets';
import { linkedinReviews as linkedin, freelanceReviews as freelance, type AvatarKey } from '../data/reviews';
import jesse from '../assets/reviews/jesse.jpg';
import med from '../assets/reviews/med.jpg';
import fateh from '../assets/reviews/fateh.jpg';
import richard from '../assets/reviews/richard.jpg';
import zach from '../assets/reviews/zach.jpg';

const avatars: Record<AvatarKey, ImageMetadata> = { jesse, med, fateh, richard, zach };

const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<div class="review-strip">
  {linkedin.map((r, i) => (
    <figure class="review fx" style={`--d:${(i % 3) * 60}ms`}>
      <div class="review-head">
        {r.avatar ? (
          <Image src={avatars[r.avatar]} alt="" widths={[80]} sizes="40px" class="review-avatar" />
        ) : (
          <span class="review-avatar review-monogram" aria-hidden="true">{initials(r.name)}</span>
        )}
        <div>
          <a class="review-name" href={r.href} rel="noopener">{r.name}</a>
          <p class="review-role">{r.role}</p>
        </div>
      </div>
      <blockquote lang={r.lang}>{r.quote}</blockquote>
      <figcaption>{r.tag} · LinkedIn</figcaption>
    </figure>
  ))}
  {freelance.map((r, i) => (
    <figure class="review fx" style={`--d:${i * 60}ms`}>
      <blockquote>{r.quote}</blockquote>
      <figcaption>{r.name} · freelancer.com</figcaption>
    </figure>
  ))}
  <p class="review-source fx">
    Recommendations from LinkedIn, plus client reviews from the freelance years: 300 projects for
    clients worldwide through Mawaki3’s freelancer.com profile (mondersky), 2012-2018.
  </p>
</div>

<style>
  .review-strip {
    columns: 3 300px;
    column-gap: 1.25rem;
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
  }
  .review {
    break-inside: avoid;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-top: 1.5px solid var(--fg);
    background: var(--surface);
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out), border-color 200ms ease;
  }
  .review:hover {
    border-color: var(--fg);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--hi);
  }
  .review-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .review-avatar {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    flex: none;
    border: 1px solid var(--fg);
  }
  .review-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--inv-accent);
    background: var(--fg);
  }
  .review-name {
    display: inline-block;
    padding-block: 6px;
    margin-block: -6px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
  }
  .review-name:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .review-role {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }
  .review blockquote {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .review > blockquote:first-child::before {
    content: '“';
    display: block;
    height: 1.4rem;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    color: var(--accent);
  }
  .review figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.5;
  }
  .review-source {
    column-span: all;
    max-width: 68ch;
    padding-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
