---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/cv';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-6">
    <a href="/" class="display text-[1.05rem] font-semibold tracking-tight">
      <span class="brand-mark" aria-hidden="true">KH</span>Khalil Hebachi<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-2.5 md:gap-4">
      <ul class="hidden items-center gap-6 text-sm lg:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                data-section-link={l.href.startsWith('/#') ? true : undefined}
                aria-current={path.startsWith(l.href) && !l.href.startsWith('/#') ? 'page' : undefined}
                class:list={[
                  'nav-link transition-colors hover:text-fg',
                  path.startsWith(l.href) && !l.href.startsWith('/#') ? 'text-fg' : 'text-muted',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-palette-open
        class="hidden items-center gap-2 rounded-ui border border-line px-2.5 py-1.5 text-sm text-muted transition-colors hover:border-muted hover:text-fg lg:inline-flex"
        aria-label="Find a page or action"
      >
        <Icon name="ph:magnifying-glass" />
        <kbd class="key !border-0 !p-0">⌘K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="inline-flex size-11 items-center justify-center rounded-ui border border-line text-muted transition-colors hover:border-muted hover:text-fg"
        aria-label="Switch between light and dark theme"
      >
        <Icon name="ph:sun" class="theme-sun" />
        <Icon name="ph:moon" class="theme-moon" />
      </button>

      <a href={`mailto:${profile.email}`} class="btn btn-primary !h-11 !px-3.5 text-sm max-sm:hidden">Email me</a>

      <button
        type="button"
        id="mnav-btn"
        class="inline-flex size-11 items-center justify-center rounded-ui border border-line text-muted lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mnav"
      >
        <Icon name="ph:list" />
      </button>
    </div>
  </nav>

  <noscript><nav aria-label="Pages without JavaScript" class="flex flex-wrap justify-center gap-x-5 gap-y-2 px-4 pb-3 text-sm">{links.map((l) => <a class="link py-2" href={l.href}>{l.label}</a>)}</nav></noscript>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
</header>

  <dialog id="mnav" aria-label="Navigation">
    <div class="mb-8 flex items-center justify-end">
      <button type="button" class="btn btn-ghost !size-11 !p-0 justify-center" data-menu-close aria-label="Close menu" autofocus><Icon name="ph:x" /></button>
    </div>
    <ul class="space-y-1">
      {
        links.map((l, i) => (
          <li>
            <a
              href={l.href}
              class="display block rounded-ui px-3 py-3.5 text-2xl font-semibold tracking-tight transition-colors hover:bg-surface"
              style={`--d:${i * 40}ms`}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex flex-wrap gap-3 px-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">Email me</a>
      <a href={profile.github} class="btn btn-ghost">GitHub</a>
    </div>
  </dialog>


<style>
  /* Sun in dark mode (click to go light), moon in light mode. */
  [data-icon].theme-moon { display: none; }
  :global([data-theme='light']) [data-icon].theme-sun { display: none; }
  :global([data-theme='light']) [data-icon].theme-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) [data-icon].theme-sun { display: none; }
    :global(:root:not([data-theme='dark'])) [data-icon].theme-moon { display: block; }
  }
</style>
