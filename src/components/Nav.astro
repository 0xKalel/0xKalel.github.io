---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/cv';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/how-i-work/', label: 'How I work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
const current = (href: string) => !href.startsWith('/#') && path.startsWith(href);
---

<header class="site-header">
  <nav class="shell nav-row" aria-label="Main">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">KH</span><span class="brand-name">Khalil Hebachi</span>
    </a>

    <div class="flex items-center gap-4 lg:gap-6">
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav-link"
                data-section-link={l.href.startsWith('/#') ? true : undefined}
                aria-current={current(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-tools">
        <button type="button" data-palette-open class="nav-icon nav-search" aria-label="Find a page or action">
          <Icon name="ph:magnifying-glass" />
          <span aria-hidden="true">⌘K</span>
        </button>

        <button type="button" data-theme-toggle class="nav-icon" aria-label="Switch between the palace (light) and dungeon (dark) theme">
          <Icon name="px-sun" class="theme-sun" />
          <Icon name="px-torch" class="theme-moon" />
        </button>

        <a href={`mailto:${profile.email}`} class="btn btn-primary nav-cta">Email me</a>

        <button
          type="button"
          id="mnav-btn"
          class="nav-icon nav-menu"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mnav"
        >
          <Icon name="ph:list" />
        </button>
      </div>
    </div>
  </nav>

  <noscript><nav aria-label="Pages without JavaScript" class="flex flex-wrap justify-center gap-x-5 gap-y-2 px-4 pb-3 text-sm">{links.map((l) => <a class="link py-2" href={l.href}>{l.label}</a>)}</nav></noscript>
</header>

<dialog id="mnav" aria-label="Navigation">
  <div class="mb-8 flex h-12 items-center justify-between">
    <span class="brand"><span class="brand-mark" aria-hidden="true">KH</span>Khalil Hebachi</span>
    <button type="button" class="nav-icon size-11!" data-menu-close aria-label="Close menu" autofocus><Icon name="ph:x" /></button>
  </div>
  <ul class="mnav-list">
    {
      links.map((l) => (
        <li>
          <a href={l.href}>
            {l.label}
            <Icon name="px-arrow-right" />
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-10 flex flex-wrap gap-4">
    <a href={`mailto:${profile.email}`} class="btn btn-primary">Email me</a>
    <a href={profile.github} class="btn btn-ghost">GitHub</a>
    <a href={profile.linkedin} class="btn btn-ghost">LinkedIn</a>
  </div>
</dialog>

<style>
  /* Sun in dark mode (click to go light), moon in light mode. */
  [data-icon].theme-moon { display: none; }
  :global([data-theme='light']) [data-icon].theme-sun { display: none; }
  :global([data-theme='light']) [data-icon].theme-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) [data-icon].theme-sun { display: none; }
    :global(:root:not([data-theme='dark'])) [data-icon].theme-moon { display: block; }
  }
</style>
