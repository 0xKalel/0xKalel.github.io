---
import { profile } from '../data/cv';
import { roles } from '../data/roles';

interface Item {
  label: string;
  hint: string;
  href?: string;
  action?: 'copy-email' | 'theme';
}

const items: Item[] = [
  { label: 'Home', hint: 'Page', href: '/' },
  { label: 'Selected work', hint: 'Page', href: '/#work' },
  { label: 'Experience since 2012', hint: 'Page', href: '/#journey' },
  { label: 'How I work', hint: 'Page', href: '/how-i-work/' },
  { label: 'Writing', hint: 'Page', href: '/blog/' },
  { label: 'Case study: StoragePal platform', hint: 'Work', href: '/work/storagepal/' },
  { label: 'Case study: SPS warehouse app', hint: 'Work', href: '/work/sps/' },
  { label: 'Case study: RavenClip', hint: 'Work', href: '/work/ravenclip/' },
  ...roles.map((r) => ({ label: `CV: ${r.label}`, hint: 'CV', href: `/cv/${r.slug}/` })),
  ...roles.map((r) => ({ label: `Download PDF: ${r.label}`, hint: 'PDF', href: `/cv/${r.slug}.pdf` })),
  { label: 'Email me', hint: 'Action', href: `mailto:${profile.email}` },
  { label: 'Copy email address', hint: 'Action', action: 'copy-email' },
  { label: 'Switch light or dark theme', hint: 'Action', action: 'theme' },
  { label: 'GitHub', hint: 'Link', href: profile.github },
  { label: 'LinkedIn', hint: 'Link', href: profile.linkedin },
];
---

<dialog id="palette" aria-label="Find a page or action">
  <input class="pal-input" type="text" name="palette-search" id="palette-search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="palette-results" aria-label="Search pages and actions" placeholder="Find a page or action…" autocomplete="off" spellcheck="false" />
  <ul id="palette-results" class="pal-list" role="listbox" aria-label="Pages and actions">
    {
      items.map((it, i) => (
        <li
          class="pal-item"
          id={`palette-item-${i}`}
          role="option"
          aria-selected="false"
          data-href={it.href}
          data-action={it.action}
        >
          <span>{it.label}</span>
          <span class="pal-k">{it.hint}</span>
        </li>
      ))
    }
  </ul>
  <p data-palette-empty class="px-5 py-6 text-sm text-muted" role="status" hidden>No matches. Try a project name or “CV”.</p>
</dialog>

<script>
  import { profile } from '../data/cv';
  let controller: AbortController | undefined;

  function initPalette() {
    controller?.abort();
    const dlg = document.getElementById('palette') as HTMLDialogElement | null;
    if (!dlg) return;
    controller = new AbortController();
    const options = { signal: controller.signal };
    const input = dlg.querySelector<HTMLInputElement>('.pal-input')!;
    const all = [...dlg.querySelectorAll<HTMLElement>('.pal-item')];
    const empty = dlg.querySelector<HTMLElement>('[data-palette-empty]')!;
    let idx = 0;
    const visible = () => all.filter((li) => !li.hidden);
    const select = (i: number) => {
      const list = visible();
      all.forEach((li) => li.setAttribute('aria-selected', 'false'));
      input.removeAttribute('aria-activedescendant');
      if (!list.length) return;
      idx = (i + list.length) % list.length;
      list[idx].setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', list[idx].id);
      list[idx].scrollIntoView({ block: 'nearest' });
    };
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      all.forEach((li) => { li.hidden = !li.textContent!.toLowerCase().includes(query); });
      empty.hidden = visible().length > 0;
      select(0);
    };
    const run = async (li: HTMLElement | undefined) => {
      if (!li) return;
      if (li.dataset.action === 'copy-email') {
        try {
          await navigator.clipboard.writeText(profile.email);
          empty.textContent = 'Email address copied.';
        } catch {
          empty.textContent = profile.email;
        }
        empty.hidden = false;
        return;
      }
      dlg.close();
      if (li.dataset.action === 'theme') {
        document.querySelector<HTMLElement>('[data-theme-toggle]')?.click();
      } else if (li.dataset.href) {
        window.location.assign(li.dataset.href);
      }
    };
    const open = () => {
      input.value = '';
      empty.textContent = 'No matches. Try a project name or “CV”.';
      dlg.showModal();
      input.setAttribute('aria-expanded', 'true');
      filter();
      input.focus();
    };
    input.addEventListener('input', () => {
      empty.textContent = 'No matches. Try a project name or “CV”.';
      filter();
    }, options);
    dlg.addEventListener('close', () => input.setAttribute('aria-expanded', 'false'), options);
    dlg.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); select(idx + 1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); select(idx - 1); }
      else if (event.key === 'Enter') { event.preventDefault(); void run(visible()[idx]); }
    }, options);
    all.forEach((li) => li.addEventListener('click', () => void run(li), options));
    dlg.addEventListener('click', (event) => { if (event.target === dlg) dlg.close(); }, options);
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dlg.open ? dlg.close() : open();
      }
    }, options);
    document.querySelectorAll('[data-palette-open]').forEach((button) => button.addEventListener('click', open, options));
  }
  document.addEventListener('astro:before-swap', () => controller?.abort());
  document.addEventListener('astro:page-load', initPalette);
</script>
