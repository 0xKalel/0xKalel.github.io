---
import { profile } from '../data/cv';
import { roles } from '../data/roles';
---

<footer class="mt-36 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-4 md:px-8">
    <div class="md:col-span-2">
      <p class="display text-lg font-semibold tracking-tight">Khalil Hebachi<span class="text-accent">.</span></p>
      <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-muted">
        Lead full-stack engineer based in Annaba, Algeria. Working with clients around the world since 2012, in English, French and Arabic.
      </p>
      <p class="mt-4 text-sm text-muted">Press <kbd class="key">⌘K</kbd> or <kbd class="key">Ctrl K</kbd> to find a page.</p>
    </div>
    <nav aria-label="Pages">
      <p class="text-sm font-medium">Pages</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-fg" href="/#work">Work</a></li>
        <li><a class="hover:text-fg" href="/#journey">Experience</a></li>
        <li><a class="hover:text-fg" href="/how-i-work/">How I work</a></li>
        <li><a class="hover:text-fg" href="/blog/">Writing</a></li>
      </ul>
    </nav>
    <nav aria-label="CV and contact">
      <p class="text-sm font-medium">CV by role</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {roles.map((r) => (
          <li><a class="hover:text-fg" href={`/cv/${r.slug}/`}>{r.label}</a></li>
        ))}
      </ul>
      <ul class="mt-5 space-y-2 text-sm text-muted">
        <li><a class="hover:text-fg" href={profile.github}>GitHub</a></li>
        <li><a class="hover:text-fg" href={profile.linkedin}>LinkedIn</a></li>
        <li><a class="hover:text-fg" href={`mailto:${profile.email}`}>{profile.email}</a></li>
      </ul>
    </nav>
  </div>
</footer>
