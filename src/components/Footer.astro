---
import { profile } from '../data/cv';
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-4 md:px-8">
    <div class="md:col-span-2">
      <p class="display text-lg font-semibold tracking-tight">Khalil Hebachi<span class="text-accent">.</span></p>
      <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-muted">
        Annaba, Algeria. English, French and Arabic.
      </p>
      <p class="mt-4 hidden text-sm text-muted lg:block">Press <kbd class="key">⌘K</kbd> or <kbd class="key">Ctrl K</kbd> to find a page.</p>
    </div>
    <nav aria-label="Pages">
      <p class="text-sm font-medium">Pages</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="inline-block py-1 hover:text-fg" href="/#work">Work</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href="/#journey">Experience</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href="/how-i-work/">How I work</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href="/blog/">Writing</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href="/cv/">CV</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href="/rss.xml">RSS feed</a></li>
      </ul>
    </nav>
    <nav aria-label="Contact">
      <p class="text-sm font-medium">Contact</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="inline-block py-1 hover:text-fg" href={profile.github}>GitHub</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href={profile.linkedin}>LinkedIn</a></li>
        <li><a class="inline-block py-1 hover:text-fg" href={`mailto:${profile.email}`}>{profile.email}</a></li>
      </ul>
    </nav>
  </div>
</footer>
