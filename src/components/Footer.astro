---
import { profile } from '../data/cv';
---

<footer class="site-footer">
  <div class="shell">
    <div class="foot-grid">
      <div>
        <p class="foot-name">Khalil<br />Hebachi</p>
        <p class="mt-4 max-w-[40ch] text-sm leading-relaxed text-muted">Lead full-stack engineer. Remote, GMT+1. English, French and Arabic.</p>
        <p class="mt-4 text-sm text-muted max-lg:hidden">Press <kbd class="key">⌘K</kbd> or <kbd class="key">Ctrl K</kbd> to find a page.</p>
      </div>
      <nav aria-label="Pages">
        <p class="mono-label">Pages</p>
        <ul class="mt-3">
          <li><a href="/#work">Work</a></li>
          <li><a href="/#journey">Experience</a></li>
          <li><a href="/how-i-work/">How I work</a></li>
          <li><a href="/blog/">Writing</a></li>
          <li><a href="/cv/">CV</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </nav>
      <nav aria-label="Contact">
        <p class="mono-label">Contact</p>
        <ul class="mt-3">
          <li><a href={profile.github}>GitHub</a></li>
          <li><a href={profile.linkedin}>LinkedIn</a></li>
          <li><a class="wrap-anywhere" href={`mailto:${profile.email}`}>{profile.email}</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-base mono-label">
      <span>Building since 2012</span>
      <span>Remote, GMT+1</span>
    </div>
  </div>
</footer>
