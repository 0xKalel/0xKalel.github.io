---
/** Media gallery for case studies: videos and screenshots as swipeable slides.
 *  Scroll-snap track, arrow buttons and dots (wired in site.ts), no autoplay.
 *  Consecutive portrait shots share a slide so phone screens never sit alone
 *  in a mostly-empty landscape frame. */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface VideoSlide {
  src: string;
  poster: string;
  caption: string;
}
interface ImageSlide {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  videos?: VideoSlide[];
  shots?: ImageSlide[];
}
const { videos = [], shots = [] } = Astro.props;

const isPortrait = (s: ImageSlide) => s.src.height > s.src.width;
const chunks: ImageSlide[][] = [];
for (const s of shots) {
  const last = chunks.at(-1);
  if (last && last.length === 1 && isPortrait(s) && isPortrait(last[0])) last.push(s);
  else chunks.push([s]);
}
const count = videos.length + chunks.length;
---

<section class="gallery rise" data-gallery aria-roledescription="carousel" aria-label={`Media gallery, ${count} items`} style="--i:2">
  <div class="gallery-frame">
    <div class="gallery-track" data-gallery-track tabindex="0">
      {
        videos.map((v, i) => (
          <figure class="gallery-slide" data-gallery-slide aria-label={`${i + 1} of ${count}`}>
            <div class="gallery-media">
              <video controls playsinline preload="metadata" poster={v.poster}>
                <source src={v.src} type="video/mp4" />
              </video>
            </div>
            <figcaption>{v.caption}</figcaption>
          </figure>
        ))
      }
      {
        chunks.map((c, i) => (
          <figure class="gallery-slide" data-gallery-slide aria-label={`${videos.length + i + 1} of ${count}`}>
            <div class="gallery-media">
              <div class:list={['gallery-fit', c.length > 1 && 'gallery-pair']}>
                {c.map((s) => (
                  <Image src={s.src} alt={s.alt} widths={[720, 1200, 1800]} sizes="(min-width: 1152px) 1088px, 100vw" />
                ))}
              </div>
            </div>
            <figcaption>{c.map((s) => s.alt).join(' · ')}</figcaption>
          </figure>
        ))
      }
    </div>
    <button type="button" class="gallery-btn gallery-prev" data-gallery-prev aria-label="Previous item"><Icon name="ph:caret-left" /></button>
    <button type="button" class="gallery-btn gallery-next" data-gallery-next aria-label="Next item"><Icon name="ph:caret-right" /></button>
  </div>
  <div class="gallery-dots" data-gallery-dots role="tablist" aria-label="Go to item">
    {Array.from({ length: count }).map((_, i) => <button type="button" role="tab" data-gallery-dot={i} aria-label={`Item ${i + 1}`} />)}
  </div>
</section>

<style>
  .gallery { margin-block: 2.5rem; }
  .gallery-frame { position: relative; }
  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .gallery-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    margin: 0;
  }
  .gallery-media {
    /* Absolutely positioned media so tall content can never stretch the frame. */
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: min(62vh, 600px);
    background: color-mix(in oklch, var(--fg) 4%, var(--surface));
  }
  .gallery-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery-fit {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-fit :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .gallery-pair {
    gap: 1.5rem;
    padding: 1.25rem;
  }
  .gallery-pair :global(img) {
    height: 100%;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 6px);
  }
  .gallery-slide figcaption {
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .gallery-btn {
    position: absolute;
    top: calc((100% - 3.2rem) / 2);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 85%, transparent);
    backdrop-filter: blur(6px);
    color: var(--fg);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .gallery-btn:hover { border-color: var(--muted); }
  .gallery-btn:active { transform: translateY(-50%) scale(0.94); }
  .gallery-btn[disabled] { opacity: 0.35; pointer-events: none; }
  .gallery-prev { left: 0.75rem; }
  .gallery-next { right: 0.75rem; }
  .gallery-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.9rem; }
  .gallery-dots button {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--line);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .gallery-dots button[aria-selected='true'] { background: var(--accent); transform: scale(1.25); }
  @media (max-width: 640px) {
    .gallery-btn { display: none; }
    .gallery-media { aspect-ratio: 4 / 3; }
    .gallery-pair { gap: 0.75rem; padding: 0.75rem; }
  }
</style>
