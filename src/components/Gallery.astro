---
/** Media gallery for case studies: videos and screenshots as swipeable slides.
 *  Scroll-snap track, arrow buttons and dots (wired in site.ts), no autoplay.
 *  Consecutive portrait shots share a slide so phone screens never sit alone
 *  in a mostly-empty landscape frame. */
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface VideoSlide {
  src: string;
  poster: ImageMetadata;
  caption: string;
}
interface ImageSlide {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  videos?: VideoSlide[];
  shots?: ImageSlide[];
}
const { videos = [], shots = [] } = Astro.props;

const isPortrait = (s: ImageSlide) => s.src.height > s.src.width;
const chunks: ImageSlide[][] = [];
for (const s of shots) {
  const last = chunks.at(-1);
  if (last && last.length === 1 && isPortrait(s) && isPortrait(last[0])) last.push(s);
  else chunks.push([s]);
}
const count = videos.length + chunks.length;
// A poster has no srcset, so each gets one WebP as wide as the frame shows it.
const posters = await Promise.all(videos.map((v) => getImage({ src: v.poster, width: 1120, format: 'webp' })));
// Portrait shots fill the frame's height (600px at most), so they need far fewer pixels than its width.
const sizing = (s: ImageSlide) => {
  if (!isPortrait(s)) return { widths: [720, 1200, 1800], sizes: '(min-width: 1152px) 1088px, 100vw' };
  const w = Math.round((600 * s.src.width) / s.src.height);
  return { widths: [w, w * 2, w * 3], sizes: `${w}px` };
};
---

<section class="gallery rise" data-gallery aria-roledescription="carousel" aria-label={`Media gallery, ${count} items`} style="--i:2">
  <div class="gallery-frame">
    <div id="project-gallery-track" class="gallery-track" data-gallery-track tabindex="0" role="group" aria-label="Product media. Use left and right arrow keys to browse.">
      {
        videos.map((v, i) => (
          <figure id={`gallery-slide-${i}`} class="gallery-slide" data-gallery-slide aria-roledescription="slide" aria-label={`${i + 1} of ${count}`}>
            <div class="gallery-media">
              <video controls playsinline preload="none" poster={posters[i].src}>
                <source src={v.src} type="video/mp4" />
              </video>
            </div>
            <figcaption>{v.caption}</figcaption>
          </figure>
        ))
      }
      {
        chunks.map((c, i) => (
          <figure id={`gallery-slide-${videos.length + i}`} class="gallery-slide" data-gallery-slide aria-roledescription="slide" aria-label={`${videos.length + i + 1} of ${count}`}>
            <div class="gallery-media">
              <div class:list={['gallery-fit', c.length > 1 && 'gallery-pair']}>
                {c.map((s) => (
                  <Image src={s.src} alt={s.alt} {...sizing(s)} />
                ))}
              </div>
            </div>
            <figcaption>{c.map((s) => s.alt).join(' · ')}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
  <div class="gallery-controls" data-gallery-controls hidden>
    <button type="button" class="gallery-btn" data-gallery-prev aria-controls="project-gallery-track" aria-label="Previous item"><Icon name="px-caret-left" /></button>
    <div class="gallery-dots" data-gallery-dots role="group" aria-label="Choose an item">
      {Array.from({ length: count }).map((_, i) => <button type="button" data-gallery-dot={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`gallery-slide-${i}`} aria-label={`Show item ${i + 1} of ${count}`}><span aria-hidden="true"></span></button>)}
    </div>
    <button type="button" class="gallery-btn" data-gallery-next aria-controls="project-gallery-track" aria-label="Next item"><Icon name="px-caret-right" /></button>
  </div>
  <p class="sr-only" data-gallery-status role="status" aria-atomic="true"></p>
</section>

<style>
  .gallery { margin-block: 2.5rem; }
  /* The gallery hangs in a stone window, like the exhibits on the homepage. */
  .gallery-frame { position: relative; padding: 8px; border: 2px solid var(--cave); background: var(--stone); box-shadow: var(--bevel), 12px 12px 0 var(--hi); }
  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline: 2px solid var(--stone-lo);
    background: var(--surface);
  }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .gallery-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    margin: 0;
  }
  .gallery-media {
    /* Absolutely positioned media so tall content can never stretch the frame. */
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: min(62vh, 600px);
    background: color-mix(in oklab, var(--fg) 4%, var(--surface));
  }
  .gallery-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery-fit {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-fit :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .gallery-pair {
    gap: 1.5rem;
    padding: 1.25rem;
  }
  .gallery-pair :global(img) {
    height: 100%;
    border: 1px solid var(--line);
  }
  .gallery-slide figcaption {
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .gallery-controls { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 24px; }
  .gallery-btn { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; border: 2px solid var(--fg); background: var(--surface); box-shadow: var(--bevel); color: var(--fg); font-size: 18px; cursor: pointer; transition: background-color 150ms ease; }
  .gallery-btn:not([disabled]):hover { background: color-mix(in oklab, var(--hi) 26%, var(--surface)); }
  .gallery-btn:not([disabled]):active { transform: translateY(2px); }
  .gallery-btn[disabled] { opacity: .35; cursor: default; }
  .gallery-dots { display: flex; justify-content: center; flex-wrap: wrap; }
  .gallery-dots button { display: grid; place-items: center; width: 44px; height: 44px; cursor: pointer; }
  /* Dots are small stone blocks; the one on show is a lit gold brick. */
  .gallery-dots button span { width: 12px; height: 12px; background: var(--stone); box-shadow: var(--bevel); }
  .gallery-dots button[aria-pressed='true'] span { width: 16px; height: 16px; background: var(--hi); box-shadow: inset 2px 2px 0 var(--flame-1), inset -2px -2px 0 var(--accent-deep); }
  @media (max-width: 640px) {
    .gallery-media { aspect-ratio: 4 / 3; }
    .gallery-pair { gap: .75rem; padding: .75rem; }
    .gallery-controls { gap: 0; }
  }
</style>
