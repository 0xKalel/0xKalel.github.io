---
/** A stone wall that fills its positioned parent: offset rows of beveled bricks drawn with the
 *  theme's stone tokens, so the Dungeon and the Palace each get their own masonry. */
import type { Pixel } from '../../lib/pixels';

interface Props {
  /** Pattern id, unique on the page. */
  id: string;
  /** CSS pixels per art pixel. */
  scale?: number;
  class?: string;
}
const { id, scale = 2, class: className } = Astro.props;

const face = 'var(--stone)';
const alt = 'color-mix(in oklab, var(--stone) 86%, var(--stone-lo))';
const hi = 'var(--stone-hi)';
const lo = 'var(--stone-lo)';
const W = 32;
const rects: Pixel[] = [];
// Bricks that cross the tile edge wrap around, so the pattern tiles without seams.
const px = (x: number, y: number, w: number, h: number, fill: string) => {
  x = ((x % W) + W) % W;
  if (x + w > W) {
    rects.push({ x, y, w: W - x, h, fill }, { x: 0, y, w: x + w - W, h, fill });
  } else rects.push({ x, y, w, h, fill });
};
for (const [bx, by, fill] of [[0, 0, face], [16, 0, alt], [8, 8, alt], [24, 8, face]] as const) {
  px(bx + 1, by + 1, 15, 7, fill);
  px(bx + 1, by + 1, 15, 1, hi);
  px(bx + 1, by + 1, 1, 7, hi);
  px(bx + 1, by + 7, 15, 1, lo);
  px(bx + 15, by + 1, 1, 7, lo);
  px(bx + (by ? 9 : 5), by + 4, 1, 1, lo);
  px(bx + (by ? 8 : 11), by + 3, 1, 1, lo);
}
---

<svg class:list={['wall', className]} aria-hidden="true" shape-rendering="crispEdges">
  <defs>
    <pattern id={id} width={W * scale} height={16 * scale} patternUnits="userSpaceOnUse">
      <g transform={`scale(${scale})`}>
        <rect width={W} height="16" style="fill: var(--mortar)" />
        {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} style={`fill: ${r.fill}`} />)}
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  .wall { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
