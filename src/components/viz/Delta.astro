---
/** A before -> after figure for one metric. Values are text, not marks. */
import { Icon } from 'astro-icon/components';

interface Item {
  label: string;
  before: string;
  after: string;
  delta?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const cols = items.length === 4 ? 2 : Math.min(items.length, 3);
---

<div class:list={['not-prose my-10 grid gap-4', cols === 2 && 'sm:grid-cols-2', cols >= 3 && 'sm:grid-cols-3']}>
  {
    items.map((it, i) => (
      <div class="card fx p-6" style={`--d:${i * 70}ms`}>
        <p class="text-sm text-muted">{it.label}</p>
        <p class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <span class="font-mono text-lg text-muted">{it.before}</span>
          <Icon name="ph:arrow-right" class="text-muted" aria-hidden="true" />
          <span class="display text-3xl font-bold">{it.after}</span>
        </p>
        {it.delta && (
          <p class="mt-3">
            <span class="rounded-full bg-[color-mix(in_oklch,var(--accent)_14%,transparent)] px-2.5 py-1 font-mono text-xs text-fg">{it.delta}</span>
          </p>
        )}
      </div>
    ))
  }
</div>
