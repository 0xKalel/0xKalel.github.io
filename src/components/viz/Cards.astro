---
/** Icon card grid for feature or problem lists. */
import { Icon } from 'astro-icon/components';

interface Item {
  icon: string;
  title: string;
  text: string;
}
interface Props {
  items: Item[];
  cols?: 2 | 3;
}
const { items, cols = 3 } = Astro.props;
---

<div class:list={['not-prose my-10 grid gap-4 sm:grid-cols-2', cols === 3 && 'lg:grid-cols-3']}>
  {
    items.map((it, i) => (
      <div class="card spot fx p-6" style={`--d:${(i % 3) * 70}ms`}>
        <span class="inline-flex size-10 items-center justify-center rounded-ui bg-[color-mix(in_oklch,var(--accent)_13%,transparent)] text-accent">
          <Icon name={it.icon} size={20} />
        </span>
        <h3 class="mt-4 font-semibold">{it.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{it.text}</p>
      </div>
    ))
  }
</div>
