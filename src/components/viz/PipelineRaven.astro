---
/** RavenClip's pipeline as a diagram: the fork into voice and visual branches,
 *  rejoining at render. Pure SVG on theme tokens. */
const H = 34;
type Pill = { x: number; y: number; w: number; label: string; kind?: 'node' | 'end' };
const pills: Pill[] = [
  { x: 6, y: 101, w: 88, label: 'News feeds' },
  { x: 112, y: 101, w: 88, label: 'Context' },
  { x: 218, y: 101, w: 88, label: 'Script', kind: 'node' },
  { x: 348, y: 30, w: 88, label: 'Voice' },
  { x: 454, y: 30, w: 104, label: 'Transcript' },
  { x: 348, y: 172, w: 88, label: 'Scenes' },
  { x: 454, y: 172, w: 104, label: 'Assets' },
  { x: 622, y: 101, w: 92, label: 'Render', kind: 'node' },
  { x: 732, y: 101, w: 88, label: 'Review' },
  { x: 838, y: 101, w: 76, label: 'Publish', kind: 'end' },
];
const lines = [
  'M94 118 L106 118',
  'M200 118 L212 118',
  'M306 112 C330 112 324 47 342 47',
  'M306 124 C330 124 324 189 342 189',
  'M436 47 L448 47',
  'M436 189 L448 189',
  'M558 47 C596 47 590 112 616 112',
  'M558 189 C596 189 590 124 616 124',
  'M714 118 L726 118',
  'M820 118 L832 118',
];
---

<figure class="not-prose card fx my-10 overflow-x-auto p-5 md:p-7">
  <figcaption class="text-[0.95rem] font-medium">From a news story to a published video</figcaption>
  <div class="mt-4 min-w-[760px]">
    <svg viewBox="0 0 920 236" class="w-full" role="img" aria-label="Pipeline diagram: news feeds, context and script run in sequence, then the flow forks into a voice branch (voice, transcript) and a visual branch (scenes, assets) that rejoin at render, followed by review and publish.">
      <defs>
        <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)"></path>
        </marker>
      </defs>
      <text x="392" y="18" fill="var(--muted)" font-size="12">voice branch</text>
      <text x="390" y="228" fill="var(--muted)" font-size="12">visual branch</text>
      {lines.map((d) => <path d={d} fill="none" stroke="var(--muted)" stroke-width="1.5" marker-end="url(#arr)" />)}
      {
        pills.map((p) => (
          <g>
            <rect
              x={p.x}
              y={p.y}
              width={p.w}
              height={H}
              rx="10"
              fill={p.kind === 'end' ? 'color-mix(in oklch, var(--accent) 16%, var(--surface))' : 'var(--raised)'}
              stroke={p.kind ? 'var(--accent)' : 'var(--line)'}
              stroke-width={p.kind === 'node' ? 1.5 : 1}
            />
            <text x={p.x + p.w / 2} y={p.y + H / 2 + 4.5} text-anchor="middle" font-size="13.5" fill="var(--fg)">{p.label}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted">
    Each stage saves its progress to the database. Processing advances when the next stage is ready, and can resume or retry after a failure.
  </p>
</figure>
