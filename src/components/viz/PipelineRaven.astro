---
/** RavenClip's pipeline as a diagram: the fork into voice and visual branches,
 *  rejoining at render. Pure SVG on theme tokens. */
const H = 34;
type Pill = { x: number; y: number; w: number; label: string; kind?: 'node' | 'end'; step: number };
const pills: Pill[] = [
  { x: 6, y: 101, w: 88, label: 'News feeds', step: 0 },
  { x: 112, y: 101, w: 88, label: 'Context', step: 1 },
  { x: 218, y: 101, w: 88, label: 'Script', kind: 'node', step: 2 },
  { x: 348, y: 30, w: 88, label: 'Voice', step: 3 },
  { x: 454, y: 30, w: 104, label: 'Transcript', step: 4 },
  { x: 348, y: 172, w: 88, label: 'Scenes', step: 3 },
  { x: 454, y: 172, w: 104, label: 'Assets', step: 4 },
  { x: 622, y: 101, w: 92, label: 'Render', kind: 'node', step: 5 },
  { x: 732, y: 101, w: 88, label: 'Review', step: 6 },
  { x: 838, y: 101, w: 76, label: 'Publish', kind: 'end', step: 7 },
];
const lines = [
  'M94 118 L106 118',
  'M200 118 L212 118',
  'M306 112 C330 112 324 47 342 47',
  'M306 124 C330 124 324 189 342 189',
  'M436 47 L448 47',
  'M436 189 L448 189',
  'M558 47 C596 47 590 112 616 112',
  'M558 189 C596 189 590 124 616 124',
  'M714 118 L726 118',
  'M820 118 L832 118',
];
const chain = (labels: [string, ('node'|'end')?][]) => labels;
---

<figure class="not-prose card fx my-10 overflow-x-auto p-5 md:p-7">
  <figcaption class="text-[0.95rem] font-medium">From a news story to a published video</figcaption>

  <!-- Mobile and tablet: the same pipeline, vertical -->
  <div class="mx-auto mt-4 w-full max-w-sm lg:hidden">
    <div class="flow-col">
      <span class="flow-pill run-pill" style="--step:0">News feeds</span>
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <span class="flow-pill run-pill" style="--step:1">Context</span>
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <span class="flow-pill flow-node run-pill" style="--step:2">Script</span>
    </div>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <div>
        <p class="mb-1.5 text-center text-[11px] text-muted">voice branch</p>
        <div class="flow-col">
          <span class="flow-pill run-pill" style="--step:3">Voice</span>
          <span class="flow-arrow" aria-hidden="true">↓</span>
          <span class="flow-pill run-pill" style="--step:4">Transcript</span>
        </div>
      </div>
      <div>
        <p class="mb-1.5 text-center text-[11px] text-muted">visual branch</p>
        <div class="flow-col">
          <span class="flow-pill run-pill" style="--step:3">Scenes</span>
          <span class="flow-arrow" aria-hidden="true">↓</span>
          <span class="flow-pill run-pill" style="--step:4">Assets</span>
        </div>
      </div>
    </div>
    <div class="flow-col mt-2">
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <span class="flow-pill flow-node run-pill" style="--step:5">Render</span>
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <span class="flow-pill run-pill" style="--step:6">Review</span>
      <span class="flow-arrow" aria-hidden="true">↓</span>
      <span class="flow-pill flow-end run-pill" style="--step:7">Publish</span>
    </div>
  </div>

  <div class="mt-4 min-w-[760px] max-lg:hidden">
    <svg viewBox="0 0 920 236" class="w-full" role="img" aria-label="Pipeline diagram: news feeds, context and script run in sequence, then the flow forks into a voice branch (voice, transcript) and a visual branch (scenes, assets) that rejoin at render, followed by review and publish.">
      <defs>
        <marker id="arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L8 4 L0 8 z" fill="var(--muted)"></path>
        </marker>
      </defs>
      <text x="392" y="18" fill="var(--muted)" font-size="12">voice branch</text>
      <text x="390" y="228" fill="var(--muted)" font-size="12">visual branch</text>
      {lines.map((d) => <path d={d} fill="none" stroke="var(--muted)" stroke-width="1.5" marker-end="url(#arr)" />)}
      {
        pills.map((p) => (
          <g>
            <rect
              class="run-pill"
              style={`--step:${p.step}`}
              x={p.x}
              y={p.y}
              width={p.w}
              height={H}
              rx="10"
              fill={p.kind === 'end' ? 'color-mix(in oklch, var(--accent) 16%, var(--surface))' : 'var(--raised)'}
              stroke={p.kind ? 'var(--accent)' : 'var(--line)'}
              stroke-width={p.kind === 'node' ? 1.5 : 1}
            />
            <text x={p.x + p.w / 2} y={p.y + H / 2 + 4.5} text-anchor="middle" font-size="13.5" fill="var(--fg)">{p.label}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted">
    Voice and visual work run in parallel before rendering. Persisted stage results let retries reuse completed work. Publishing runs automatically or after customer review, according to the channel settings.
  </p>
</figure>

<style>
  .flow-col { display: flex; flex-direction: column; align-items: stretch; }
  .flow-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--raised);
    font-size: 0.875rem;
  }
  .flow-node { border-color: var(--accent); border-width: 1.5px; }
  .flow-end { background: color-mix(in oklch, var(--accent) 16%, var(--surface)); border-color: var(--accent); }
  .flow-arrow { text-align: center; color: var(--muted); font-size: 0.8rem; line-height: 1.4; }

  /* The autopilot, visualised: stages light up in run order, forever.
     One slow, motivated loop; removed entirely under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .run-pill {
      animation: stage-run 9s calc(var(--step) * 0.55s) infinite;
    }
    svg .run-pill { transform-box: fill-box; transform-origin: center; }
  }
  @keyframes stage-run {
    0%, 4% { filter: none; }
    6%, 12% {
      stroke: var(--accent);
      border-color: var(--accent);
      filter: drop-shadow(0 0 6px color-mix(in oklch, var(--accent) 55%, transparent));
    }
    18%, 100% { filter: none; }
  }
</style>
