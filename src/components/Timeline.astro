---
import { evidence } from '../data/evidence';
import { experience, projects, type Entry } from '../data/cv';
const hooks: Record<string, string> = {
  mawaki3: 'Co-founded an agency and grew the team to seven developers.',
  blackyellow: 'Built a ticketing system for major UK retailers.',
  aviadmin: 'Cut calendar load time from 34 seconds to 0.3 seconds.',
  singularity: 'Improved database performance and delivered ten features.',
  atlas: 'Launched five AI products serving 600+ daily users.',
  storagepal: 'Lead platform development and built the SPS warehouse app end to end.',
  ravenclip: `Built my own news-to-video product. First external paying customer in ${evidence.ravenclip.daysToCustomer} days.`,
};
const entries: Entry[] = [...projects, ...experience];
---

<ol class="experience-list">
  {entries.map((e, i) => (
    <li class="experience-row fx" style={`--d:${Math.min(i * 30, 120)}ms`}>
      <p class="experience-date">{e.period}</p>
      <div>
        <h3>{e.org}{e.period.includes('present') && <span class="current-tag">Now</span>}</h3>
        <p class="experience-role">{e.title}</p>
        <p class="experience-summary">{hooks[e.id]}</p>
      </div>
    </li>
  ))}
</ol>
