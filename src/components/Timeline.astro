---
import { Icon } from 'astro-icon/components';
import { experience, projects, type Entry } from '../data/cv';
import { inline } from '../lib/inline';

// The career, oldest first. Hooks retell each era; bullets come from the CV data.
const hooks: Record<string, string> = {
  mawaki3:
    'Monder and I founded Mawaki3 after a hackathon in Annaba: he had the freelancer.com profile, I had the office. We grew to 7 developers, trained juniors, and shipped nearly 300 projects for clients around the world, while building our own products on the side. The hard lesson: every developer we trained eventually left to freelance alone, so in 2018 I went full time with international teams. Twelve years on, Monder and I still ship together at StoragePal.',
  blackyellow:
    'Built in-house PHP and JavaScript frameworks and a ticketing system used by major UK retailers. I also introduced Docker and automated build and deployment pipelines.',
  aviadmin:
    'Remote contract for a Danish aviation company: modernised a PHP 5.4 codebase, rebuilt the frontend in Vue, and took their calendar from 34 seconds to 0.3.',
  singularity:
    'Performance and delivery work for an Estonian team: 60% faster through query optimisation and indexing, plus ten production features.',
  atlas:
    'Built and launched five AI software products in about a year, serving 600+ daily active users. The work brought together video processing, external AI services, subscriptions and publishing.',
  storagepal:
    'Lead developer for a Paris storage business. I set the technical roadmap, work with two developers and two testers, and built the warehouse app from design through to ongoing support.',
  ravenclip:
    'Founded RavenClip, a product that turns news into short videos and publishes them automatically. I built and launched it, reaching paying customers in agencies, consultancies and coaching within four months of the first commit.',
};

const entries: Entry[] = [...experience].reverse().concat(projects);
const year = (e: Entry) => e.period.match(/\d{4}/)?.[0] ?? '';
---

<ol class="tl mt-14 space-y-12">
  {
    entries.map((e, i) => (
      <li class:list={['tl-item fx', i === entries.length - 1 && 'now']}>
        <span class="tl-dot" aria-hidden="true" />
        <p class="font-mono text-sm text-accent">{year(e)}</p>
        <h3 class="display mt-1.5 text-2xl font-semibold tracking-tight">
          {e.org}
          <span class="font-normal text-muted"> · {e.title}</span>
        </h3>
        <p class="mt-0.5 text-sm text-muted">{e.location}, {e.period}</p>
        <p class="mt-3 max-w-[62ch] leading-relaxed text-muted">{hooks[e.id]}</p>
        <div class="acc-item mt-4">
          <button class="acc-btn inline-flex items-center gap-2 text-sm font-medium text-accent" aria-expanded="false">
            <Icon name="ph:plus" class="ph-plus" /> Work and results
          </button>
          <div class="acc">
            <div>
              <ul class="mt-4 max-w-[68ch] space-y-2.5 border-l border-line pl-5 text-[0.95rem] leading-relaxed text-muted">
                {e.bullets.map((b) => (
                  <li set:html={inline(b.text)} />
                ))}
              </ul>
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  li :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
</style>
