---
import { Icon } from 'astro-icon/components';
import { experience, projects, type Entry } from '../data/cv';
import { inline } from '../lib/inline';

// The career, oldest first. Hooks retell each era; bullets come from the CV data.
const hooks: Record<string, string> = {
  mawaki3:
    'Founded my own agency and ran it for six years: 2 people to 7, and 100+ projects for clients in the US, France and the UK. Where architecture, QA and leading a team stopped being theory.',
  blackyellow:
    'Built custom PHP and JavaScript frameworks with zero dependencies, and ran Docker and CI/CD in 2018, before either was assumed. The best education in fundamentals I ever got.',
  aviadmin:
    'Remote contract for a Danish aviation company: modernised a PHP 5.4 codebase, rebuilt the frontend in Vue, and took their calendar from 34 seconds to 0.3.',
  singularity:
    'Performance and delivery work for an Estonian team: 60% faster through query optimisation and indexing, plus ten production features.',
  atlas:
    'The AI chapter begins: five AI SaaS products shipped in about a year, 600+ daily users. Fast because of the decade before it, since queues, provider failover and billing were already old friends.',
  storagepal:
    'Lead developer for a Paris storage business. The platform runs the whole company; I set the roadmap, direct two developers and two testers, and built the warehouse app end to end.',
  ravenclip:
    'My own SaaS: a newsroom that runs itself, publishing daily across 10+ AI providers without a human in the loop. Paying customers within four months of the first commit: agencies, consultancies and coaches.',
};

const entries: Entry[] = [...experience].reverse().concat(projects);
const year = (e: Entry) => e.period.match(/\d{4}/)?.[0] ?? '';
---

<ol class="tl mt-14 space-y-12">
  {
    entries.map((e, i) => (
      <li class:list={['tl-item fx', i === entries.length - 1 && 'now']}>
        <span class="tl-dot" aria-hidden="true" />
        <p class="font-mono text-sm text-accent">{year(e)}</p>
        <h3 class="display mt-1.5 text-2xl font-semibold tracking-tight">
          {e.org}
          <span class="font-normal text-muted"> · {e.title}</span>
        </h3>
        <p class="mt-0.5 text-sm text-muted">{e.location}, {e.period}</p>
        <p class="mt-3 max-w-[62ch] leading-relaxed text-muted">{hooks[e.id]}</p>
        <div class="acc-item mt-4">
          <button class="acc-btn inline-flex items-center gap-2 text-sm font-medium text-accent" aria-expanded="false">
            <Icon name="ph:plus" class="ph-plus" /> What I shipped
          </button>
          <div class="acc">
            <div>
              <ul class="mt-4 max-w-[68ch] space-y-2.5 border-l border-line pl-5 text-[0.95rem] leading-relaxed text-muted">
                {e.bullets.map((b) => (
                  <li set:html={inline(b.text)} />
                ))}
              </ul>
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  li :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
</style>
